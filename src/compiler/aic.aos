Program {
  Import(path="parser.aos")
  Import(path="format.aos")
  Import(path="validate.aos")
  Import(path="resolve.aos")
  Import(path="project.aos")
  Import(path="template.aos")
  Import(path="bundle.aos")
  Import(path="linker.aos")
  Import(path="bootstrap_io.aos")
  Import(path="value.aos")
  Import(path="eval.aos")
  Import(sdk="ailang" path="std/bytes.aos")
  Export(name=main)

  Let(name=main) {
    Fn(params=args) {
      Block {
        Let(name=cmd) { Call(target=readCmd) { Var(name=args) } }
        If {
          Eq { Var(name=cmd) Lit(value="fmt") }
          Block { Return { Call(target=runFmt) { Var(name=args) } } }
          Block {
            If {
              Eq { Var(name=cmd) Lit(value="check") }
              Block { Return { Call(target=runCheck) { Var(name=args) } } }
              Block {
                If {
                  Eq { Var(name=cmd) Lit(value="run") }
                  Block { Return { Call(target=runRun) { Lit(value=0) } } }
                  Block {
                    If {
                      Eq { Var(name=cmd) Lit(value="publish") }
                      Block { Return { Call(target=runPublish) { Var(name=args) } } }
                      Block {
                        If {
                          Eq { Var(name=cmd) Lit(value="test") }
                          Block { Return { Call(target=runTest) { Var(name=args) } } }
                          Block {
                            If {
                              Eq { Var(name=cmd) Lit(value="init") }
                              Block { Return { Call(target=runNew) { Var(name=args) } } }
                              Block {
                                Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AIC001 message=\"Unknown subcommand.\" nodeId=argv)") }
                                Return { Lit(value=1) }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=readCmd) {
    Fn(params=args) {
      Block {
        If {
          Eq { ChildCount { Var(name=args) } Lit(value=0) }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              AttrValueString {
                ChildAt { Var(name=args) Lit(value=0) }
                Lit(value=0)
              }
            }
          }
        }
      }
    }
  }

  Let(name=readArg) {
    Fn(params=args,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=args) } }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              AttrValueString {
                ChildAt { Var(name=args) Var(name=index) }
                Lit(value=0)
              }
            }
          }
        }
      }
    }
  }

  Let(name=runTest) {
    Fn(params=args) {
      Block {
        Let(name=dir) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        If {
          Eq { Var(name=dir) Lit(value="") }
          Block {
            Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AIC002 message=\"Missing test directory.\" nodeId=argv)") }
            Return { Lit(value=1) }
          }
          Block {
            Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AIC003 message=\"Self-hosted test command is not implemented yet.\" nodeId=test)") }
            Return { Lit(value=1) }
          }
        }
      }
    }
  }

  Let(name=runNew) {
    Fn(params=args) {
      Block {
        Let(name=name) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        If {
          Eq { Var(name=name) Lit(value="") }
          Block {
            Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AICN001 message=\"Missing project name.\" nodeId=argv)") }
            Return { Lit(value=1) }
          }
          Block {
            If {
              Call(target=bootstrapIo.pathExists) { Var(name=name) }
              Block {
                Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AICN002 message=\"Directory already exists.\" nodeId=name)") }
                Return { Lit(value=1) }
              }
              Block {
                Let(name=template) { Call(target=readArg) { Var(name=args) Lit(value=2) } }
                Let(name=resolvedTemplate) { Call(target=template.resolveName) { Var(name=template) } }
                If {
                  Call(target=template.isSupported) { Var(name=resolvedTemplate) }
                  Block {
                    Let(name=srcDir) { StrConcat { Var(name=name) Lit(value="/src") } }
                    Let(name=assetsDir) { StrConcat { Var(name=name) Lit(value="/Assets") } }
                    Let(name=assetsImagesDir) { StrConcat { Var(name=name) Lit(value="/Assets/images") } }
                    Let(name=assetsFontsDir) { StrConcat { Var(name=name) Lit(value="/Assets/fonts") } }
                    Let(name=assetsLocaleDir) { StrConcat { Var(name=name) Lit(value="/Assets/locale") } }
                    Let(name=assetsLocaleEnPath) { StrConcat { Var(name=name) Lit(value="/Assets/locale/en.toml") } }
                    Let(name=projectPath) { StrConcat { Var(name=name) Lit(value="/project.aiproj") } }
                    Let(name=appPath) { StrConcat { Var(name=name) Lit(value="/src/app.aos") } }
                    Let(name=agentsPath) { StrConcat { Var(name=name) Lit(value="/AGENTS.md") } }
                    Let(name=gitignorePath) { StrConcat { Var(name=name) Lit(value="/.gitignore") } }
                    Call(target=bootstrapIo.makeDir) { Var(name=name) }
                    Call(target=bootstrapIo.makeDir) { Var(name=srcDir) }
                    Call(target=bootstrapIo.makeDir) { Var(name=assetsDir) }
                    Call(target=bootstrapIo.makeDir) { Var(name=assetsImagesDir) }
                    Call(target=bootstrapIo.makeDir) { Var(name=assetsFontsDir) }
                    Call(target=bootstrapIo.makeDir) { Var(name=assetsLocaleDir) }
                    Call(target=bootstrapIo.writeFile) { Var(name=projectPath) Call(target=project.buildDefaultManifest) { Var(name=name) } }
                    If {
                      Eq { Var(name=resolvedTemplate) Lit(value="cli") }
                      Block {
                        Call(target=bootstrapIo.writeFile) { Var(name=appPath) Call(target=template.buildCliApp) { Lit(value=0) } }
                      }
                      Block {
                        If {
                          Eq { Var(name=resolvedTemplate) Lit(value="http") }
                          Block {
                            Call(target=bootstrapIo.writeFile) { Var(name=appPath) Call(target=template.buildHttpApp) { Lit(value=0) } }
                          }
                          Block {
                            If {
                              Eq { Var(name=resolvedTemplate) Lit(value="gui") }
                              Block {
                                Call(target=bootstrapIo.writeFile) { Var(name=appPath) Call(target=template.buildGuiApp) { Lit(value=0) } }
                              }
                              Block {
                                Call(target=bootstrapIo.writeFile) { Var(name=appPath) Call(target=template.buildLibApp) { Lit(value=0) } }
                              }
                            }
                          }
                        }
                      }
                    }
                    Call(target=bootstrapIo.writeFile) { Var(name=agentsPath) Call(target=template.buildAgentsDoc) { Var(name=resolvedTemplate) } }
                    Call(target=bootstrapIo.writeFile) { Var(name=gitignorePath) Call(target=template.buildGitIgnore) { Lit(value=0) } }
                    Call(target=bootstrapIo.writeFile) { Var(name=assetsLocaleEnPath) Call(target=template.buildLocaleSeedData) { Lit(value=0) } }
                    Call(target=sys.stdout.writeLine) { Lit(value="Ok#ok1(type=string value=\"project-created\")") }
                    Return { Lit(value=0) }
                  }
                  Block {
                    Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AICN003 message=\"Unknown template.\" nodeId=template)") }
                    Return { Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runPublish) {
    Fn(params=args) {
      Block {
        Let(name=dir) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        If {
          Eq { Var(name=dir) Lit(value="") }
          Block {
            Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AICP001 message=\"Missing publish directory.\" nodeId=argv)") }
            Return { Lit(value=1) }
          }
          Block {
            Let(name=manifestPath) { StrConcat { Var(name=dir) Lit(value="/project.aiproj") } }
            If {
              Call(target=sys.fs.file.exists) { Var(name=manifestPath) }
              Block {
                Let(name=parsed) { Call(target=parse.parseDocument) { Call(target=bytes.toUtf8String) { Call(target=sys.fs.file.read) { Var(name=manifestPath) } } } }
                If {
                  Eq { NodeKind { Var(name=parsed) } Lit(value="Err") }
                  Block {
                    Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=parsed) } }
                    Return { Lit(value=1) }
                  }
                  Block {
                    Let(name=diags) { Call(target=validate) { Var(name=parsed) } }
                    If {
                      Eq { ChildCount { Var(name=diags) } Lit(value=0) }
                      Block {
                        Let(name=projectNode) { ChildAt { Var(name=parsed) Lit(value=0) } }
                        Let(name=projectName) { Call(target=getAttr) { Var(name=projectNode) Lit(value="name") Lit(value=0) } }
                        Let(name=entryFile) { Call(target=getAttr) { Var(name=projectNode) Lit(value="entryFile") Lit(value=0) } }
                        Let(name=entryExport) { Call(target=getAttr) { Var(name=projectNode) Lit(value="entryExport") Lit(value=0) } }
                        Let(name=entryPath) { StrConcat { Var(name=dir) StrConcat { Lit(value="/") Var(name=entryFile) } } }
                        Let(name=entryParsed) { Call(target=parse.parseDocument) { Call(target=bytes.toUtf8String) { Call(target=sys.fs.file.read) { Var(name=entryPath) } } } }
                        If {
                          Eq { NodeKind { Var(name=entryParsed) } Lit(value="Err") }
                          Block {
                            Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=entryParsed) } }
                            Return { Lit(value=1) }
                          }
                          Block {
                            Let(name=undeclaredPackageImportNodeId) {
                              Call(target=resolve.findFirstUndeclaredPackageImport) {
                                Var(name=entryParsed)
                                Var(name=projectNode)
                                Lit(value=0)
                              }
                            }
                            If {
                              Eq { Var(name=undeclaredPackageImportNodeId) Lit(value="") }
                              Block {
                                Let(name=modulePaths) {
                                  Call(target=linker.collectProjectModulePaths) {
                                    Var(name=dir)
                                    Var(name=entryParsed)
                                    Var(name=entryFile)
                                  }
                                }
                                If {
                                  Eq { NodeKind { Var(name=modulePaths) } Lit(value="Err") }
                                  Block {
                                    Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=modulePaths) } }
                                    Return { Lit(value=1) }
                                  }
                                  Block {
                                Let(name=linkReportDir) {
                                  StrConcat {
                                    Var(name=dir)
                                    Lit(value="/obj")
                                  }
                                }
                                Let(name=linkReportPath) {
                                  StrConcat {
                                    Var(name=linkReportDir)
                                    Lit(value="/link-report.aos")
                                  }
                                }
                                Call(target=bootstrapIo.makeDir) { Var(name=linkReportDir) }
                                Call(target=bootstrapIo.writeFile) {
                                  Var(name=linkReportPath)
                                  Call(target=linker.buildLinkReportText) {
                                    Var(name=modulePaths)
                                  }
                                }
                                Let(name=bundleText) {
                                  Call(target=bundle.buildLinkedBundleText) {
                                    Var(name=projectName)
                                    Var(name=entryExport)
                                    Var(name=modulePaths)
                                  }
                                }
                                Let(name=publishProgramText) { Call(target=bundle.buildPublishProgramText) { Var(name=bundleText) Var(name=projectName) } }
                                Let(name=publishProgram) { Call(target=parse.parseDocument) { Var(name=publishProgramText) } }
                                If {
                                  Eq { NodeKind { Var(name=publishProgram) } Lit(value="Err") }
                                  Block {
                                    Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=publishProgram) } }
                                    Return { Lit(value=1) }
                                  }
                                  Block {
                                    Let(name=publishResult) { Call(target=eval.runProgram) { Var(name=publishProgram) } }
                                    If {
                                      Eq { NodeKind { Var(name=publishResult) } Lit(value="Err") }
                                      Block {
                                        Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=publishResult) } }
                                        Return { Lit(value=1) }
                                      }
                                      Block {
                                        Call(target=sys.stdout.writeLine) { Lit(value="Ok#ok1(type=string value=\"publish-complete\")") }
                                        Return { Lit(value=0) }
                                      }
                                    }
                                  }
                                }
                                  }
                                }
                              }
                              Block {
                                Call(target=sys.stdout.writeLine) {
                                  Call(target=format.format) {
                                    MakeErr {
                                      Lit(value="runtime_err")
                                      Lit(value="RUN024")
                                      Lit(value="Package import is not declared in project manifest.")
                                      Var(name=undeclaredPackageImportNodeId)
                                    }
                                  }
                                }
                                Return { Lit(value=1) }
                              }
                            }
                          }
                        }
                      }
                      Block {
                        Call(target=sys.stdout.writeLine) { Call(target=format.format) { ChildAt { Var(name=diags) Lit(value=0) } } }
                        Return { Lit(value=1) }
                      }
                    }
                  }
                }
              }
              Block {
                Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AICP002 message=\"project.aiproj not found.\" nodeId=project)") }
                Return { Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=readAndParse) {
    Fn(params=_) {
      Block {
        Return {
          Call(target=parse.parseDocument) {
            Call(target=sys.console.readAllStdin)
          }
        }
      }
    }
  }

  Let(name=runFmt) {
    Fn(params=args) {
      Block {
        Let(name=parsed) { Call(target=readAndParse) { Lit(value=0) } }
        Let(name=mode) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        If {
          Eq { Var(name=mode) Lit(value="--ids") }
          Block { Call(target=sys.stdout.writeLine) { Call(target=formatWithIds) { Var(name=parsed) } } }
          Block { Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=parsed) } } }
        }
        Return { Lit(value=0) }
      }
    }
  }


  Let(name=runCheck) {
    Fn(params=args) {
      Block {
        Let(name=parsed) { Call(target=readAndParse) { Lit(value=0) } }
        Let(name=mode) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Err") }
          Block {
            Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=parsed) } }
            Return { Lit(value=1) }
          }
          Block {
            Let(name=diags) { Call(target=validate) { Var(name=parsed) } }
            If {
              Eq { ChildCount { Var(name=diags) } Lit(value=0) }
              Block {
                Call(target=sys.stdout.writeLine) { Lit(value="Ok#ok0(type=void)") }
                Return { Lit(value=0) }
              }
              Block {
                Call(target=sys.stdout.writeLine) {
                  Call(target=format.format) {
                    ChildAt { Var(name=diags) Lit(value=0) }
                  }
                }
                Return { Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runRun) {
    Fn(params=_) {
      Block {
        Let(name=parsed) { Call(target=readAndParse) { Lit(value=0) } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Err") }
          Block {
            Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=parsed) } }
            Return { Lit(value=1) }
          }
          Block {
            Let(name=diags) { Call(target=validate) { Var(name=parsed) } }
            If {
              Eq { ChildCount { Var(name=diags) } Lit(value=0) }
              Block {
                Let(name=value) { Call(target=eval.runProgram) { Var(name=parsed) } }
                If {
                  Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
                  Block {
                    Call(target=value.emitOkFromValue) { Var(name=value) }
                    Return
                  }
                  Block {
                    If {
                      Eq { NodeId { Var(name=value) } Lit(value="void") }
                      Block {
                        Call(target=value.emitOkFromValue) { Var(name=value) }
                        Return
                      }
                      Block {
                        Call(target=sys.stdout.writeLine) { Call(target=format.format) { Var(name=value) } }
                        Return
                      }
                    }
                    Return { Lit(value=1) }
                  }
                }
              }
              Block {
                Call(target=sys.stdout.writeLine) {
                  Call(target=format.format) {
                    ChildAt { Var(name=diags) Lit(value=0) }
                  }
                }
                Return { Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=getAttr) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block { Return { Call(target=getAttr) { Var(name=node) Var(name=key) Add { Var(name=index) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }


  Call(target=main) { Var(name=argv) }
}
