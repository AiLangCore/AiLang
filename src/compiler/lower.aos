                      Eq { ChildCount { Var(name=body) } Lit(value=1) }
                      Block { Return { Call(target=lower.emitReturnExpressionAtCore) { ChildAt { Var(name=body) Lit(value=0) } Var(name=instructionIndex) } } }
                      Block { Return { Lit(value="Unsupported(reason=\"match-default-body\") ") } }
                    }
                  }
                  Block { Return { Lit(value="Unsupported(reason=\"match-arm\") ") } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.matchEqualityOp) {
    Fn(params=label) {
      Block {
        If {
          Eq { NodeKind { Var(name=label) } Lit(value="Lit") }
          Block {
            Let(name=kind) { AttrValueKind { Var(name=label) Lit(value=0) } }
            If {
              Eq { Var(name=kind) Lit(value="int") }
              Block { Return { Lit(value="EQ_INT") } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="string") }
                  Block { Return { Lit(value="EQ") } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="bool") }
                      Block { Return { Lit(value="EQ") } }
                      Block { Return { Lit(value="") } }
                    }
                  }
                }
              }
            }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.emitGeneralParameterMatchArms) {
    Fn(params=matchNode,slot,armIndex,instructionIndex) {
      Block {
        If {
          Eq { Var(name=armIndex) ChildCount { Var(name=matchNode) } }
          Block { Return { Lit(value="Unsupported(reason=\"match-no-default\") ") } }
          Block {
            Let(name=arm) { ChildAt { Var(name=matchNode) Var(name=armIndex) } }
            If {
              Eq { NodeKind { Var(name=arm) } Lit(value="Case") }
              Block {
                Let(name=label) { ChildAt { Var(name=arm) Lit(value=0) } }
                Let(name=body) { ChildAt { Var(name=arm) Lit(value=1) } }
                Let(name=op) { Call(target=lower.matchEqualityOp) { Var(name=label) } }
                If {
                  Eq { Var(name=op) Lit(value="") }
                  Block { Return { Lit(value="Unsupported(reason=\"match-case-label\") ") } }
                  Block {
                    If {
                      Eq { ChildCount { Var(name=body) } Lit(value=1) }
                      Block {
                        Let(name=result) { ChildAt { Var(name=body) Lit(value=0) } }
                        If {
                          Eq { NodeKind { Var(name=result) } Lit(value="Lit") }
                          Block {
                            Let(name=nextInstruction) { Add { Var(name=instructionIndex) Lit(value=6) } }
                            Return {
                              StrConcat {
                                Lit(value="Inst(op=\"LOAD_LOCAL\" a=")
                                StrConcat {
                                  ToString { Var(name=slot) }
                                  StrConcat {
                                    Lit(value=") Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=")
                                    StrConcat {
                                      ToString { Add { Var(name=instructionIndex) Lit(value=1) } }
                                      StrConcat {
                                        Lit(value=" target=\"")
                                        StrConcat {
                                          Call(target=lower.literalConstantTextTarget) { Var(name=label) }
                                          StrConcat {
                                            Lit(value="\") Inst(op=\"")
                                            StrConcat {
                                              Var(name=op)
                                              StrConcat {
                                                Lit(value="\" a=0) Inst(op=\"JUMP_IF_FALSE\" a=0) Reloc(kind=\"jump\" instruction=")
                                                StrConcat {
                                                  ToString { Add { Var(name=instructionIndex) Lit(value=3) } }
                                                  StrConcat {
                                                    Lit(value=" targetInstruction=")
                                                    StrConcat {
                                                      ToString { Var(name=nextInstruction) }
                                                      StrConcat {
                                                        Lit(value=") Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=")
                                                        StrConcat {
                                                          ToString { Add { Var(name=instructionIndex) Lit(value=4) } }
                                                          StrConcat {
                                                            Lit(value=" target=\"")
                                                            StrConcat {
                                                              Call(target=lower.literalConstantTextTarget) { Var(name=result) }
                                                              StrConcat { Lit(value="\") Inst(op=\"RETURN\") ") Call(target=lower.emitGeneralParameterMatchArms) { Var(name=matchNode) Var(name=slot) Add { Var(name=armIndex) Lit(value=1) } Var(name=nextInstruction) } }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          Block { Return { Lit(value="Unsupported(reason=\"match-case-body\") ") } }
                        }
                      }
                      Block { Return { Lit(value="Unsupported(reason=\"match-case-body\") ") } }
                    }
                  }
                }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=arm) } Lit(value="Default") }
                  Block {
                    Let(name=body) { ChildAt { Var(name=arm) Lit(value=0) } }
                    If {
                      Eq { ChildCount { Var(name=body) } Lit(value=1) }
                      Block { Return { Call(target=lower.emitLiteralReturnAt) { ChildAt { Var(name=body) Lit(value=0) } Var(name=instructionIndex) } } }
                      Block { Return { Lit(value="Unsupported(reason=\"match-default-body\") ") } }
                    }
                  }
                  Block { Return { Lit(value="Unsupported(reason=\"match-arm\") ") } }
                }
              }
            }
          }
        }
      }
    }
  }





}
