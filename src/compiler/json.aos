Program {
  Let(name=std.json.stringify) {
    Fn(params=node) {
      Block {
        If {
          Eq { NodeKind { Var(name=node) } Lit(value="Map") }
          Block { Return { Call(target=json_map) { Var(name=node) } } }
          Block {
            If {
              Eq { NodeKind { Var(name=node) } Lit(value="Lit") }
              Block { Return { Call(target=json_lit) { Var(name=node) } } }
              Block { Return { Lit(value="null") } }
            }
          }
        }
      }
    }
  }

  Let(name=json_map) {
    Fn(params=mapNode) {
      Block {
        If {
          Eq { ChildCount { Var(name=mapNode) } Lit(value=0) }
          Block { Return { Lit(value="{}") } }
          Block {
            Let(name=picked) { MakeBlock { Lit(value="picked") } }
            Let(name=body) { Call(target=json_map_emit) { Var(name=mapNode) Var(name=picked) Lit(value=0) } }
            Return {
              StrConcat {
                Lit(value="{")
                StrConcat {
                  Var(name=body)
                  Lit(value="}")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_map_emit) {
    Fn(params=mapNode,picked,count) {
      Block {
        If {
          Eq { Var(name=count) ChildCount { Var(name=mapNode) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=minIndex) {
              Call(target=json_find_min_index) {
                Var(name=mapNode)
                Var(name=picked)
                Lit(value=0)
                Lit(value=-1)
                Lit(value="")
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=minIndex) Lit(value=-1) }
              Block { Return { Lit(value="") } }
              Block {
                Let(name=field) { ChildAt { Var(name=mapNode) Var(name=minIndex) } }
                Let(name=key) { Call(target=json_field_key) { Var(name=field) } }
                Let(name=entry) { Call(target=json_field_json) { Var(name=field) } }
                Let(name=nextPicked) { Call(target=json_picked_add) { Var(name=picked) Var(name=key) } }
                Let(name=rest) {
                  Call(target=json_map_emit) {
                    Var(name=mapNode)
                    Var(name=nextPicked)
                    Add { Var(name=count) Lit(value=1) }
                  }
                }
                If {
                  Eq { Var(name=rest) Lit(value="") }
                  Block { Return { Var(name=entry) } }
                  Block {
                    Return {
                      StrConcat {
                        Var(name=entry)
                        StrConcat {
                          Lit(value=",")
                          Var(name=rest)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_find_min_index) {
    Fn(params=mapNode,picked,index,bestIndex,bestKey,hasBest) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=mapNode) } }
          Block { Return { Var(name=bestIndex) } }
          Block {
            Let(name=field) { ChildAt { Var(name=mapNode) Var(name=index) } }
            Let(name=key) { Call(target=json_field_key) { Var(name=field) } }
            If {
              Call(target=json_picked_has) { Var(name=picked) Var(name=key) Lit(value=0) }
              Block {
                Return {
                  Call(target=json_find_min_index) {
                    Var(name=mapNode)
                    Var(name=picked)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=bestIndex)
                    Var(name=bestKey)
                    Var(name=hasBest)
                  }
                }
              }
              Block {
                If {
                  Var(name=hasBest)
                  Block {
                    Let(name=cmp) { Call(target=compiler.strCompare) { Var(name=key) Var(name=bestKey) } }
                    If {
                      Eq { Var(name=cmp) Lit(value=-1) }
                      Block {
                        Return {
                          Call(target=json_find_min_index) {
                            Var(name=mapNode)
                            Var(name=picked)
                            Add { Var(name=index) Lit(value=1) }
                            Var(name=index)
                            Var(name=key)
                            Lit(value=true)
                          }
                        }
                      }
                      Block {
                        Return {
                          Call(target=json_find_min_index) {
                            Var(name=mapNode)
                            Var(name=picked)
                            Add { Var(name=index) Lit(value=1) }
                            Var(name=bestIndex)
                            Var(name=bestKey)
                            Var(name=hasBest)
                          }
                        }
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=json_find_min_index) {
                        Var(name=mapNode)
                        Var(name=picked)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=index)
                        Var(name=key)
                        Lit(value=true)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_picked_add) {
    Fn(params=picked,key) {
      Block {
        Let(name=lit) { MakeLitString { Lit(value="picked_key") Var(name=key) } }
        Return { AppendChild { Var(name=picked) Var(name=lit) } }
      }
    }
  }

  Let(name=json_picked_has) {
    Fn(params=picked,key,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=picked) } }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=current) { ChildAt { Var(name=picked) Var(name=index) } }
            If {
              Eq { Call(target=json_lit_string) { Var(name=current) } Var(name=key) }
              Block { Return { Lit(value=true) } }
              Block {
                Return {
                  Call(target=json_picked_has) {
                    Var(name=picked)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_field_json) {
    Fn(params=field) {
      Block {
        Let(name=key) { Call(target=json_field_key) { Var(name=field) } }
        If {
          Eq { ChildCount { Var(name=field) } Lit(value=1) }
          Block {
            Let(name=valueText) { Call(target=std.json.stringify) { ChildAt { Var(name=field) Lit(value=0) } } }
            Return {
              StrConcat {
                Lit(value="\"")
                StrConcat {
                  StrEscape { Var(name=key) }
                  StrConcat {
                    Lit(value="\":")
                    Var(name=valueText)
                  }
                }
              }
            }
          }
          Block {
            Return {
              StrConcat {
                Lit(value="\"")
                StrConcat {
                  StrEscape { Var(name=key) }
                  Lit(value="\":null")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_field_key) {
    Fn(params=field) {
      Block { Return { Call(target=json_attr_string) { Var(name=field) Lit(value="key") Lit(value=0) } } }
    }
  }

  Let(name=json_lit_string) {
    Fn(params=lit) {
      Block {
        Let(name=valueIndex) { Call(target=json_attr_index) { Var(name=lit) Lit(value="value") Lit(value=0) } }
        If {
          Eq { Var(name=valueIndex) Lit(value=-1) }
          Block { Return { Lit(value="") } }
          Block { Return { AttrValueString { Var(name=lit) Var(name=valueIndex) } } }
        }
      }
    }
  }

  Let(name=json_lit) {
    Fn(params=lit) {
      Block {
        Let(name=valueIndex) { Call(target=json_attr_index) { Var(name=lit) Lit(value="value") Lit(value=0) } }
        If {
          Eq { Var(name=valueIndex) Lit(value=-1) }
          Block { Return { Lit(value="null") } }
          Block {
            Let(name=kind) { AttrValueKind { Var(name=lit) Var(name=valueIndex) } }
            If {
              Eq { Var(name=kind) Lit(value="string") }
              Block {
                Return {
                  StrConcat {
                    Lit(value="\"")
                    StrConcat {
                      StrEscape { AttrValueString { Var(name=lit) Var(name=valueIndex) } }
                      Lit(value="\"")
                    }
                  }
                }
              }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="int") }
                  Block { Return { ToString { AttrValueInt { Var(name=lit) Var(name=valueIndex) } } } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="bool") }
                      Block {
                        If {
                          AttrValueBool { Var(name=lit) Var(name=valueIndex) }
                          Block { Return { Lit(value="true") } }
                          Block { Return { Lit(value="false") } }
                        }
                      }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="identifier") }
                          Block {
                            If {
                              Eq { AttrValueString { Var(name=lit) Var(name=valueIndex) } Lit(value="null") }
                              Block { Return { Lit(value="null") } }
                              Block { Return { Lit(value="null") } }
                            }
                          }
                          Block { Return { Lit(value="null") } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_attr_string) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=json_attr_string) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=json_attr_index) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value=-1) } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { Var(name=index) } }
              Block {
                Return {
                  Call(target=json_attr_index) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
