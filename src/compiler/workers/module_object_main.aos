Program {
  Import(sdk="ailang" path="std/process.aos")
  Import(path="../format.aos")
  Import(path="../build_telemetry.aos")
  Import(path="module_object.aos")
  Export(name=main)

  Let(name=main) {
    Fn(params=args) {
      Block {
        Let(name=startedAt) { Call(target=buildTelemetry.now) {} }
        Let(name=result) { Call(target=moduleObjectWorkerRun) { Var(name=args) } }
        If {
          Eq { NodeKind { Var(name=result) } Lit(value="Err") }
          Block {
            Call(target=sys.stdout.writeLine) {
              Call(target=format.format) { Var(name=result) }
            }
            Call(target=exit) { Lit(value=1) }
            Return { Lit(value=1) }
          }
          Block {
            Call(target=buildTelemetry.worker) {
              AttrValueInt { Var(name=result) Lit(value=0) }
              AttrValueInt { Var(name=result) Lit(value=1) }
              Var(name=startedAt)
            }
            Call(target=exit) { Lit(value=0) }
            Return { Lit(value=0) }
          }
        }
      }
    }
  }
}
