Program#project_p1 {
  Export#project_e1(name=project.isProjectManifest)
  Export#project_e2(name=project.buildDefaultManifest)

  Let#project_l1(name=project.isProjectManifest) {
    Fn#project_f1(params=parsed) {
      Block#project_b1 {
        If#project_if1 {
          Eq#project_e1a { NodeKind#project_nk1 { Var#project_v1(name=parsed) } Lit#project_i1(value="Program") }
          Block#project_b2 {
            If#project_if2 {
              Eq#project_e2a { ChildCount#project_cc1 { Var#project_v2(name=parsed) } Lit#project_i2(value=1) }
              Block#project_b3 {
                Return#project_r1 {
                  Eq#project_e3a {
                    NodeKind#project_nk2 { ChildAt#project_ca1 { Var#project_v3(name=parsed) Lit#project_i3(value=0) } }
                    Lit#project_i4(value="Project")
