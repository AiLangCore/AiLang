        Return {
          StrConcat {
            Lit(value="Inst(op=\"LOAD_LOCAL\" a=")
            StrConcat {
              ToString { Var(name=slot) }
              StrConcat {
                Lit(value=") Inst(op=\"CALL\" a=0) Reloc(kind=\"call\" instruction=")
                StrConcat { ToString { Add { Var(name=instructionIndex) Lit(value=1) } } StrConcat { Lit(value=" targetName=\"") StrConcat { StrEscape { Var(name=target) } Lit(value="\") Inst(op=\"RETURN\") ") } } }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.localSlot) {
    Fn(params=body,name,baseSlot,index,lastIndex) {
      Block {
        If {
          Eq { Var(name=index) Var(name=lastIndex) }
          Block { Return { Lit(value=-1) } }
          Block {
            Let(name=localNode) { ChildAt { Var(name=body) Var(name=index) } }
            If {
              Eq { Call(target=lower.getAttr) { Var(name=localNode) Lit(value="name") Lit(value=0) } Var(name=name) }
              Block { Return { Add { Var(name=baseSlot) Var(name=index) } } }
              Block { Return { Call(target=lower.localSlot) { Var(name=body) Var(name=name) Var(name=baseSlot) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) } } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.parameterCount) {
    Fn(params=params,index) {
      Block {
        If {
          Eq { Var(name=params) Lit(value="") }
          Block { Return { Lit(value=0) } }
          Block {
            If {
              Eq { StringFind { Var(name=params) Lit(value=",") Var(name=index) } Lit(value=-1) }
              Block { Return { Lit(value=1) } }
              Block {
                Let(name=comma) { StringFind { Var(name=params) Lit(value=",") Var(name=index) } }
                Return { Add { Lit(value=1) Call(target=lower.parameterCount) { Var(name=params) Add { Var(name=comma) Lit(value=1) } } } }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitParameterProlog) {
    Fn(params=params,start,slot) {
      Block {
        If {
          Eq { Var(name=params) Lit(value="") }
          Block { Return { Lit(value="") } }
          Block { Return { Call(target=lower.emitParameterStores) { Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } } }
        }
      }
    }
  }

  Let(name=lower.emitParameterStores) {
    Fn(params=slot) {
      Block {
        If {
          Eq { Var(name=slot) Lit(value=-1) }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                Lit(value="Inst(op=\"STORE_LOCAL\" a=")
                StrConcat { ToString { Var(name=slot) } StrConcat { Lit(value=") ") Call(target=lower.emitParameterStores) { Sub { Var(name=slot) Lit(value=1) } } } }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStdoutThenReturnBody) {
    Fn(params=body) {
      Block {
        Let(name=callNode) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=1) } }
        If {
          Eq { NodeKind { Var(name=callNode) } Lit(value="Call") }
          Block {
            If {
              Eq { Call(target=lower.getAttr) { Var(name=callNode) Lit(value="target") Lit(value=0) } Lit(value="sys.stdout.writeLine") }
              Block {
                Let(name=message) { Call(target=lower.stdoutStringLiteral) { Var(name=callNode) } }
