Program {
  Import(path="parser.aos")

  Let(name=compiler.parseHttpRequest) {
    Fn(params=raw) {
      Block {
        Let(name=method) { Call(target=compiler.strToken) { Var(name=raw) Lit(value=0) } }
        Let(name=path) { Call(target=compiler.strToken) { Var(name=raw) Lit(value=1) } }
        Return { Call(target=http_make_request) { Var(name=method) Var(name=path) } }
      }
    }
  }

  Let(name=http_make_request) {
    Fn(params=method,path) {
      Block {
        Let(name=programText) {
          StrConcat {
            Lit(value="Program#hp_auto { HttpRequest#auto(method=\"")
            StrConcat {
              StrEscape { Var(name=method) }
              StrConcat {
                Lit(value="\" path=\"")
                StrConcat {
                  StrEscape { Var(name=path) }
                  Lit(value="\") }")
                }
              }
            }
          }
        }
        Let(name=parsed) { Call(target=parse.parseDocument) { Var(name=programText) } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Program") }
          Block { Return { ChildAt { Var(name=parsed) Lit(value=0) } } }
          Block {
            Let(name=fallback) { Call(target=parse.parseDocument) { Lit(value="Program#hp_fallback { HttpRequest#auto(method=\"\" path=\"\") }") } }
            Return { ChildAt { Var(name=fallback) Lit(value=0) } }
          }
        }
      }
    }
  }

}
