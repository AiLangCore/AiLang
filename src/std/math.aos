Program#std_math_p1 {
  Import#std_math_i1(path="./number.aos")

  Let#std_math_l1(name=halfFloor) {
    Fn#std_math_f1(params=value,acc) {
      Block#std_math_b1 {
        If#std_math_if1 {
          Call#std_math_c1(target=lt) { Var#std_math_v1(name=value) Lit#std_math_i1(value=2) }
          Block#std_math_b2 { Return#std_math_r1 { Var#std_math_v2(name=acc) } }
          Block#std_math_b3 {
            Return#std_math_r2 {
              Call#std_math_c2(target=halfFloor) {
                Call#std_math_c3(target=sub) { Var#std_math_v3(name=value) Lit#std_math_i2(value=2) }
                Call#std_math_c4(target=inc) { Var#std_math_v4(name=acc) }
              }
            }
          }
        }
      }
    }
  }

  Let#std_math_l2(name=divFloor) {
    Fn#std_math_f2(params=value,step,acc) {
      Block#std_math_b4 {
        If#std_math_if2 {
          Call#std_math_c5(target=lt) { Var#std_math_v5(name=value) Var#std_math_v6(name=step) }
          Block#std_math_b5 { Return#std_math_r3 { Var#std_math_v7(name=acc) } }
          Block#std_math_b6 {
            Return#std_math_r4 {
              Call#std_math_c6(target=divFloor) {
                Call#std_math_c7(target=sub) { Var#std_math_v8(name=value) Var#std_math_v9(name=step) }
                Var#std_math_v10(name=step)
                Call#std_math_c8(target=inc) { Var#std_math_v11(name=acc) }
              }
            }
          }
        }
      }
    }
  }

  Let#std_math_l3(name=subAbs) {
    Fn#std_math_f3(params=a,b) {
      Block#std_math_b7 {
        Return#std_math_r5 {
          Call#std_math_c9(target=abs) {
            Call#std_math_c10(target=sub) {
              Var#std_math_v12(name=a)
              Var#std_math_v13(name=b)
            }
          }
        }
      }
    }
  }

  Export#std_math_e1(name=halfFloor)
  Export#std_math_e2(name=divFloor)
  Export#std_math_e3(name=subAbs)
}
