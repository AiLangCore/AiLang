Program {
  Export(name=object.emitModuleText)
  Export(name=object.emitSymbols)

  Let(name=object.emitModuleText) {
    Fn(params=program,modulePath) {
      Block {
        Return {
          StrConcat {
            Lit(value="Object(format=\"AiBCO1\" modulePath=\"")
            StrConcat {
              StrEscape { Var(name=modulePath) }
              StrConcat {
                Lit(value="\" version=1) { ")
                StrConcat {
                  Call(target=object.emitImports) { Var(name=program) Lit(value=0) }
                  StrConcat {
                    Call(target=object.emitExports) { Var(name=program) Var(name=modulePath) Lit(value=0) }
                    StrConcat {
                      Call(target=object.emitSymbols) { Var(name=program) Var(name=modulePath) Lit(value=0) }
                      StrConcat {
                        Call(target=object.emitFunctions) { Var(name=program) Var(name=modulePath) Lit(value=0) }
                        Lit(value="}")
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=object.emitImports) {
    Fn(params=program,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=program) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=child) { ChildAt { Var(name=program) Var(name=index) } }
            Let(name=tail) { Call(target=object.emitImports) { Var(name=program) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Import") }
              Block {
                Let(name=path) { Call(target=object.getAttr) { Var(name=child) Lit(value="path") Lit(value=0) } }
                If {
                  Eq { Var(name=path) Lit(value="") }
                  Block { Return { Var(name=tail) } }
                  Block {
                    Return {
                      StrConcat {
                        Lit(value="Import(path=\"")
                        StrConcat { StrEscape { Var(name=path) } StrConcat { Lit(value="\") ") Var(name=tail) } }
                      }
                    }
                  }
                }
              }
              Block { Return { Var(name=tail) } }
            }
          }
        }
      }
    }
  }

  Let(name=object.emitExports) {
    Fn(params=program,modulePath,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=program) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=child) { ChildAt { Var(name=program) Var(name=index) } }
            Let(name=tail) { Call(target=object.emitExports) { Var(name=program) Var(name=modulePath) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Export") }
              Block {
                Let(name=name) { Call(target=object.getAttr) { Var(name=child) Lit(value="name") Lit(value=0) } }
                Return {
                  StrConcat {
                    Lit(value="Export(name=\"")
                    StrConcat {
                      StrEscape { Var(name=name) }
                      StrConcat {
                        Lit(value="\" symbol=\"")
                        StrConcat {
                          Call(target=object.symbol) { Var(name=modulePath) Var(name=name) }
                          StrConcat { Lit(value="\") ") Var(name=tail) }
                        }
                      }
                    }
                  }
                }
              }
              Block { Return { Var(name=tail) } }
            }
          }
        }
      }
    }
  }

  Let(name=object.emitFunctions) {
    Fn(params=program,modulePath,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=program) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=child) { ChildAt { Var(name=program) Var(name=index) } }
            Let(name=tail) { Call(target=object.emitFunctions) { Var(name=program) Var(name=modulePath) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Let") }
              Block {
                If {
                  Eq { ChildCount { Var(name=child) } Lit(value=1) }
                  Block {
                    Let(name=value) { ChildAt { Var(name=child) Lit(value=0) } }
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Fn") }
                      Block {
                        Let(name=name) { Call(target=object.getAttr) { Var(name=child) Lit(value="name") Lit(value=0) } }
                        Let(name=params) { Call(target=object.getAttr) { Var(name=value) Lit(value="params") Lit(value=0) } }
                        Return {
                          StrConcat {
                            Lit(value="Function(name=\"")
                            StrConcat {
                              StrEscape { Var(name=name) }
                              StrConcat {
                                Lit(value="\" symbol=\"")
                                StrConcat {
                                  Call(target=object.symbol) { Var(name=modulePath) Var(name=name) }
                                  StrConcat {
                                    Lit(value="\" params=\"")
                                    StrConcat { StrEscape { Var(name=params) } StrConcat { Lit(value="\" locals=\"") StrConcat { StrEscape { Var(name=params) } StrConcat { Lit(value="\") {} ") Var(name=tail) } } } }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      Block { Return { Var(name=tail) } }
                    }
                  }
                  Block { Return { Var(name=tail) } }
                }
              }
              Block { Return { Var(name=tail) } }
            }
          }
        }
      }
    }
  }

  Let(name=object.emitSymbols) {
    Fn(params=program,modulePath,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=program) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=child) { ChildAt { Var(name=program) Var(name=index) } }
            Let(name=tail) { Call(target=object.emitSymbols) { Var(name=program) Var(name=modulePath) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Let") }
              Block {
                If {
                  Eq { ChildCount { Var(name=child) } Lit(value=1) }
                  Block {
                    Let(name=value) { ChildAt { Var(name=child) Lit(value=0) } }
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Fn") }
                      Block {
                        Let(name=name) { Call(target=object.getAttr) { Var(name=child) Lit(value="name") Lit(value=0) } }
                        Let(name=symbol) { Call(target=object.symbol) { Var(name=modulePath) Var(name=name) } }
                        Let(name=prefix) { StrConcat { Lit(value="Symbol(kind=\"function\" name=\"") StrEscape { Var(name=name) } } }
                        Let(name=middle) { StrConcat { Var(name=prefix) StrConcat { Lit(value="\" symbol=\"") Var(name=symbol) } } }
                        Return { StrConcat { Var(name=middle) StrConcat { Lit(value="\") ") Var(name=tail) } } }
                      }
                      Block { Return { Var(name=tail) } }
                    }
                  }
                  Block { Return { Var(name=tail) } }
                }
              }
              Block { Return { Var(name=tail) } }
            }
          }
        }
      }
    }
  }

  Let(name=object.symbol) {
    Fn(params=modulePath,name) {
      Block { Return { StrConcat { StrEscape { Var(name=modulePath) } StrConcat { Lit(value="::") StrEscape { Var(name=name) } } } } }
    }
  }

  Let(name=object.getAttr) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block { Return { Call(target=object.getAttr) { Var(name=node) Var(name=key) Add { Var(name=index) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }
}
