  Let(name=lower.emitReturnNodeAt) {
    Fn(params=returnNode,instructionIndex) {
      Block {
        If {
          Eq { NodeKind { Var(name=returnNode) } Lit(value="Return") }
          Block {
            If {
              Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
              Block { Return { Call(target=lower.emitReturnExpressionAt) { ChildAt { Var(name=returnNode) Lit(value=0) } Var(name=instructionIndex) } } }
              Block { Return { Lit(value="Unsupported(reason=\"return-missing-expression\") ") } }
            }
          }
          Block { Return { Lit(value="Unsupported(reason=\"function-body-not-return\") ") } }
        }
      }
    }
  }

  Let(name=lower.stdoutStringLiteral) {
    Fn(params=callNode) {
      Block {
        If {
          Eq { ChildCount { Var(name=callNode) } Lit(value=1) }
          Block {
            Let(name=value) { ChildAt { Var(name=callNode) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
              Block {
                If {
                  Eq { AttrValueKind { Var(name=value) Lit(value=0) } Lit(value="string") }
                  Block { Return { Var(name=value) } }
                  Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER001") Lit(value="stdout requires a string literal.") Lit(value="call") } } }
                }
              }
              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER001") Lit(value="stdout requires a string literal.") Lit(value="call") } } }
            }
          }
