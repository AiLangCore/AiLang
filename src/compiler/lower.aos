                  Block { Return { Lit(value="Unsupported(reason=\"stdout-argument\") ") } }
                  Block {
                    Return {
                      StrConcat {
                        Lit(value="Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=0 target=\"string:sys.stdout.writeLine\") Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=1 target=\"string:")
                        StrConcat {
                          StrEscape { AttrValueString { Var(name=message) Lit(value=0) } }
                          StrConcat { Lit(value="\") Inst(op=\"CALL_SYS\" a=1) Inst(op=\"POP\") ") Call(target=lower.emitReturnNodeAt) { Var(name=returnNode) Lit(value=4) } }
                        }
                      }
                    }
                  }
                }
              }
              Block { Return { Lit(value="Unsupported(reason=\"call-target\") ") } }
