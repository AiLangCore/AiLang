Program {
  Import(path="parser.aos")
  Import(path="eval.aos")
  Import(sdk="ailang" path="std/bytes.aos")

  Export(name=runtime.start)

  Let(name=runtime.start) {
    Fn(params=args) {
      Block {
        Let(name=mode) { Call(target=runtime_arg_string) { Var(name=args) Lit(value=0) } }
        If {
          Eq { Var(name=mode) Lit(value="serve") }
          Block { Return { Call(target=runtime_serve) { Var(name=args) } } }
          Block { Return { Call(target=runtime_run) { Var(name=args) } } }
        }
      }
    }
  }

  Let(name=runtime_run) {
    Fn(params=args) {
      Block {
        Let(name=__runtime_suppress_output) { Lit(value=false) }
        If {
          Eq { Var(name=__vm_mode) Lit(value="bytecode") }
          Block {
            If {
              Call(target=runtime_has_export) { Var(name=__program) Lit(value="init") Lit(value=0) }
              Block {
                If {
                  Call(target=runtime_has_export) { Var(name=__program) Lit(value="update") Lit(value=0) }
                  Block { Lit(value=0) }
                  Block { Return { Call(target=runtime_run_vm) { Lit(value=0) } } }
                }
              }
              Block { Return { Call(target=runtime_run_vm) { Lit(value=0) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=runtime_has_export) { Var(name=__program) Lit(value="init") Lit(value=0) }
          Block {
            If {
              Call(target=runtime_has_export) { Var(name=__program) Lit(value="update") Lit(value=0) }
              Block {
                Let(name=__runtime_suppress_output) { Lit(value=true) }
                Let(name=state) { Call(target=init) { Var(name=argv) } }
                Let(name=event) { Call(target=runtime_make_run_event) { Var(name=argv) } }
                Let(name=next) { Call(target=runtime.dispatch) { Var(name=state) Var(name=event) } }
                Return { Call(target=runtime_handle_next_run) { Var(name=next) Var(name=state) } }
              }
              Block {
                If {
                  Call(target=runtime_has_export) { Var(name=__program) Lit(value="start") Lit(value=0) }
                  Block { Return { Call(target=start) { Var(name=argv) } } }
                  Block { Return { Var(name=__program_result) } }
                }
              }
            }
          }
          Block {
            If {
              Call(target=runtime_has_export) { Var(name=__program) Lit(value="start") Lit(value=0) }
              Block { Return { Call(target=start) { Var(name=argv) } } }
              Block {
                Let(name=entryExport) { Var(name=__entryExport) }
                If {
                  Eq { Var(name=entryExport) Lit(value="") }
                  Block { Return { Var(name=__program_result) } }
                  Block { Return { Call(target=runtime_call_named_export) { Var(name=entryExport) } } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_run_vm) {
    Fn(params=_) {
      Block {
        Let(name=bc) { Call(target=compiler.emitBytecode) { Var(name=__program) } }
        If {
          Eq { NodeKind { Var(name=bc) } Lit(value="Err") }
          Block { Return { Var(name=bc) } }
          Block { Return { Call(target=sys.vm.run) { Var(name=bc) Lit(value="main") Var(name=argv) } } }
        }
      }
    }
  }

  Let(name=runtime_serve) {
    Fn(params=args) {
      Block {
        Let(name=port) { Call(target=runtime_arg_int) { Var(name=args) Lit(value=1) } }
        Let(name=tlsCertPath) { Call(target=runtime_arg_string) { Var(name=args) Lit(value=2) } }
        Let(name=tlsKeyPath) { Call(target=runtime_arg_string) { Var(name=args) Lit(value=3) } }
        Let(name=listener) {
          If {
            Eq { Var(name=tlsCertPath) Lit(value="") }
            Block {
              If {
                Eq { Var(name=tlsKeyPath) Lit(value="") }
                Block {
                  Call(target=sys.net.tcp.listen) {
                    Lit(value="127.0.0.1")
                    Var(name=port)
                  }
                }
                Block { MakeErr { Lit(value="runtime_err") Lit(value="TLS001") Lit(value="--tls-key requires --tls-cert.") Lit(value="serve") } }
              }
            }
            Block {
              If {
                Eq { Var(name=tlsKeyPath) Lit(value="") }
                Block { MakeErr { Lit(value="runtime_err") Lit(value="TLS002") Lit(value="--tls-cert requires --tls-key.") Lit(value="serve") } }
                Block {
                  Call(target=sys.net.tcp.listenTls) {
                    Lit(value="127.0.0.1")
                    Var(name=port)
                    Var(name=tlsCertPath)
                    Var(name=tlsKeyPath)
                  }
                }
              }
            }
          }
        }
        If {
          Eq { NodeKind { Var(name=listener) } Lit(value="Err") }
          Block { Return { Var(name=listener) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=listener) Lit(value=-1) }
          Block {
            Return {
              MakeErr {
                Lit(value="runtime_err")
                Lit(value="TLS003")
                Lit(value="Failed to load TLS certificate or key.")
                Lit(value="serve")
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=serveMsg) {
          StrConcat {
            Lit(value="host started on: localhost:")
            ToString { Var(name=port) }
          }
        }
        Call(target=sys.stdout.writeLine) { Var(name=serveMsg) }
        Call(target=sys.stdout.writeLine) { Lit(value="ctrl c to exit..") }
        Let(name=state) { Call(target=init) { Var(name=argv) } }
        Return { Call(target=runtime_serve_loop) { Var(name=listener) Var(name=state) } }
      }
    }
  }

  Let(name=runtime_serve_loop) {
    Fn(params=listener,state) {
      Block {
        Let(name=conn) { Call(target=sys.net.tcp.accept) { Var(name=listener) } }
        If {
          Eq { Var(name=conn) Lit(value=-1) }
          Block { Return { Lit(value=0) } }
          Block {
            Let(name=rawBytes) {
              Call(target=runtime_read_request_bytes) {
                Var(name=conn)
                Call(target=bytes.fromBase64) { Lit(value="") }
                Lit(value=16)
              }
            }
            Let(name=raw) { Call(target=bytes.toUtf8String) { Var(name=rawBytes) } }
            Let(name=event) { Call(target=runtime_make_event) { Var(name=raw) } }
            Let(name=next) { Call(target=runtime.dispatch) { Var(name=state) Var(name=event) } }
            Let(name=nextState) { Call(target=runtime_handle_next) { Var(name=next) Var(name=conn) Var(name=state) } }
            Call(target=sys.net.tcp.close) { Var(name=conn) }
            Return { Call(target=runtime_serve_loop) { Var(name=listener) Var(name=nextState) } }
          }
        }
      }
    }
  }

  Let(name=runtime.dispatch) {
    Fn(params=state,event) {
      Block { Return { Call(target=update) { Var(name=state) Var(name=event) } } }
    }
  }

  Let(name=runtime_read_request_bytes) {
    Fn(params=conn,acc,remainingReads) {
      Block {
        If {
          Eq { Var(name=remainingReads) Lit(value=0) }
          Block { Return { Var(name=acc) } }
          Block {
            Let(name=chunk) {
              Call(target=sys.net.tcp.read) {
                Var(name=conn)
                Lit(value=8192)
              }
            }
            Let(name=combined) { Call(target=bytes.concat) { Var(name=acc) Var(name=chunk) } }
            Let(name=chunkLen) { Call(target=bytes.length) { Var(name=chunk) } }
            If {
              Eq { Var(name=chunkLen) Lit(value=8192) }
              Block {
                Return {
                  Call(target=runtime_read_request_bytes) {
                    Var(name=conn)
                    Var(name=combined)
                    Add { Var(name=remainingReads) Lit(value=-1) }
                  }
                }
              }
              Block { Return { Var(name=combined) } }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_make_event) {
    Fn(params=payload) {
      Block {
        Let(name=programText) {
          StrConcat {
            Lit(value="Program#rt_event_p1 { Event#Message(type=\"net.request\" payload=\"")
            StrConcat {
              StrEscape { Var(name=payload) }
              Lit(value="\") }")
            }
          }
        }
        Let(name=parsed) { Call(target=parse.parseDocument) { Var(name=programText) } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Program") }
          Block { Return { ChildAt { Var(name=parsed) Lit(value=0) } } }
          Block {
            Let(name=fallback) { Call(target=parse.parseDocument) { Lit(value="Program#rt_event_p2 { Event#Message(type=\"net.request\" payload=\"\") }") } }
            Return { ChildAt { Var(name=fallback) Lit(value=0) } }
          }
        }
      }
    }
  }

  Let(name=runtime_handle_next) {
    Fn(params=next,conn,currentState) {
      Block {
        If {
          Eq { NodeKind { Var(name=next) } Lit(value="Block") }
          Block {
            If {
              Eq { ChildCount { Var(name=next) } Lit(value=0) }
              Block {
                Call(target=sys.net.tcp.write) { Var(name=conn) Call(target=runtime_http_204) { Lit(value=0) } }
                Return { Var(name=currentState) }
              }
              Block {
                Let(name=newState) { ChildAt { Var(name=next) Lit(value=0) } }
                Let(name=didWrite) { Call(target=runtime_handle_commands) { Var(name=next) Lit(value=1) Var(name=conn) Lit(value=false) } }
                If {
                  Var(name=didWrite)
                  Block { Return { Var(name=newState) } }
                  Block {
                    Call(target=sys.net.tcp.write) { Var(name=conn) Call(target=runtime_http_204) { Lit(value=0) } }
                    Return { Var(name=newState) }
                  }
                }
              }
            }
          }
          Block {
            Call(target=sys.net.tcp.write) { Var(name=conn) Call(target=runtime_http_204) { Lit(value=0) } }
            Return { Var(name=next) }
          }
        }
      }
    }
  }

  Let(name=runtime_handle_commands) {
    Fn(params=block,index,conn,didWrite) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=block) } }
          Block { Return { Var(name=didWrite) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=block) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=cmd) } Lit(value="Command") }
              Block {
                If {
                  Eq { NodeId { Var(name=cmd) } Lit(value="Exit") }
                  Block {
                    Call(target=sys.process.exit) { Call(target=runtime_attr_int) { Var(name=cmd) Lit(value="code") Lit(value=0) } }
                    Return { Var(name=didWrite) }
                  }
                  Block {
                    If {
                      Eq { NodeId { Var(name=cmd) } Lit(value="Emit") }
                      Block {
                        Let(name=emitType) { Call(target=runtime_attr_string) { Var(name=cmd) Lit(value="type") Lit(value=0) } }
                        Let(name=emitPayload) { Call(target=runtime_attr_string) { Var(name=cmd) Lit(value="payload") Lit(value=0) } }
                        If {
                          Eq { Var(name=emitType) Lit(value="stdout") }
                          Block { Call(target=sys.stdout.writeLine) { Var(name=emitPayload) } }
                          Block { Lit(value=0) }
                        }
                        If {
                          Eq { Var(name=emitType) Lit(value="http.response") }
                          Block {
                            Call(target=sys.net.tcp.write) { Var(name=conn) Call(target=runtime_http_200) { Var(name=emitPayload) } }
                            Return {
                              Call(target=runtime_handle_commands) {
                                Var(name=block)
                                Add { Var(name=index) Lit(value=1) }
                                Var(name=conn)
                                Lit(value=true)
                              }
                            }
                          }
                          Block { Lit(value=0) }
                        }
                        If {
                          Eq { Var(name=emitType) Lit(value="http.raw") }
                          Block {
                            Call(target=sys.net.tcp.write) { Var(name=conn) Var(name=emitPayload) }
                            Return {
                              Call(target=runtime_handle_commands) {
                                Var(name=block)
                                Add { Var(name=index) Lit(value=1) }
                                Var(name=conn)
                                Lit(value=true)
                              }
                            }
                          }
                          Block { Lit(value=0) }
                        }
                      }
                      Block { Lit(value=0) }
                    }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            Return {
              Call(target=runtime_handle_commands) {
                Var(name=block)
                Add { Var(name=index) Lit(value=1) }
                Var(name=conn)
                Var(name=didWrite)
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_http_200) {
    Fn(params=payload) {
      Block {
        Return {
          StrConcat {
            Lit(value="HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n")
            Var(name=payload)
          }
        }
      }
    }
  }

  Let(name=runtime_http_204) {
    Fn(params=_) {
      Block { Return { Lit(value="HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n") } }
    }
  }

  Let(name=runtime_make_start_event) {
    Fn(params=_) {
      Block {
        Let(name=parsed) { Call(target=parse.parseDocument) { Lit(value="Program#rt_start_p1 { Event#Start }") } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Program") }
          Block { Return { ChildAt { Var(name=parsed) Lit(value=0) } } }
          Block {
            Let(name=fallback) { Call(target=parse.parseDocument) { Lit(value="Program#rt_start_p2 { Event#Message(type=\"start\" payload=\"\") }") } }
            Return { ChildAt { Var(name=fallback) Lit(value=0) } }
          }
        }
      }
    }
  }

  Let(name=runtime_make_run_event) {
    Fn(params=args) {
      Block {
        If {
          Eq { Call(target=runtime_arg_string) { Var(name=args) Lit(value=0) } Lit(value="__event_message") }
          Block {
            Let(name=eventType) { Call(target=runtime_arg_string) { Var(name=args) Lit(value=1) } }
            Let(name=eventPayload) { Call(target=runtime_arg_string) { Var(name=args) Lit(value=2) } }
            Let(name=programText) {
              StrConcat {
                Lit(value="Program#rt_message_p1 { Event#Message(type=\"")
                StrConcat {
                  StrEscape { Var(name=eventType) }
                  StrConcat {
                    Lit(value="\" payload=\"")
                    StrConcat {
                      StrEscape { Var(name=eventPayload) }
                      Lit(value="\") }")
                    }
                  }
                }
              }
            }
            Let(name=parsed) { Call(target=parse.parseDocument) { Var(name=programText) } }
            If {
              Eq { NodeKind { Var(name=parsed) } Lit(value="Program") }
              Block { Return { ChildAt { Var(name=parsed) Lit(value=0) } } }
              Block { Return { Call(target=runtime_make_start_event) { Lit(value=0) } } }
            }
          }
          Block { Return { Call(target=runtime_make_start_event) { Lit(value=0) } } }
        }
      }
    }
  }

  Let(name=runtime_handle_next_run) {
    Fn(params=next,currentState) {
      Block {
        If {
          Eq { NodeKind { Var(name=next) } Lit(value="Block") }
          Block {
            If {
              Eq { ChildCount { Var(name=next) } Lit(value=0) }
              Block { Return { Var(name=currentState) } }
              Block {
                Let(name=newState) { ChildAt { Var(name=next) Lit(value=0) } }
                Call(target=runtime_handle_commands_run) { Var(name=next) Lit(value=1) }
                Return { Var(name=newState) }
              }
            }
          }
          Block {
            If {
              Eq { NodeKind { Var(name=next) } Lit(value="Command") }
              Block {
                If {
                  Eq { NodeId { Var(name=next) } Lit(value="Exit") }
                  Block { Call(target=sys.process.exit) { Call(target=runtime_attr_int) { Var(name=next) Lit(value="code") Lit(value=0) } } }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { NodeId { Var(name=next) } Lit(value="Print") }
                  Block { Call(target=sys.stdout.writeLine) { Call(target=runtime_attr_string) { Var(name=next) Lit(value="text") Lit(value=0) } } }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { NodeId { Var(name=next) } Lit(value="Emit") }
                  Block {
                    Let(name=emitType) { Call(target=runtime_attr_string) { Var(name=next) Lit(value="type") Lit(value=0) } }
                    If {
                      Eq { Var(name=emitType) Lit(value="stdout") }
                      Block { Call(target=sys.stdout.writeLine) { Call(target=runtime_attr_string) { Var(name=next) Lit(value="payload") Lit(value=0) } } }
                      Block { Lit(value=0) }
                    }
                  }
                  Block { Lit(value=0) }
                }
                Return { Var(name=currentState) }
              }
              Block { Return { Var(name=next) } }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_handle_commands_run) {
    Fn(params=block,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=block) } }
          Block { Return { Lit(value=0) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=block) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=cmd) } Lit(value="Command") }
              Block {
                If {
                  Eq { NodeId { Var(name=cmd) } Lit(value="Exit") }
                  Block { Call(target=sys.process.exit) { Call(target=runtime_attr_int) { Var(name=cmd) Lit(value="code") Lit(value=0) } } }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { NodeId { Var(name=cmd) } Lit(value="Print") }
                  Block { Call(target=sys.stdout.writeLine) { Call(target=runtime_attr_string) { Var(name=cmd) Lit(value="text") Lit(value=0) } } }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { NodeId { Var(name=cmd) } Lit(value="Emit") }
                  Block {
                    Let(name=emitType) { Call(target=runtime_attr_string) { Var(name=cmd) Lit(value="type") Lit(value=0) } }
                    Let(name=emitPayload) { Call(target=runtime_attr_string) { Var(name=cmd) Lit(value="payload") Lit(value=0) } }
                    If {
                      Eq { Var(name=emitType) Lit(value="stdout") }
                      Block { Call(target=sys.stdout.writeLine) { Var(name=emitPayload) } }
                      Block { Lit(value=0) }
                    }
                  }
                  Block { Lit(value=0) }
                }
              }
              Block { Lit(value=0) }
            }
            Return { Call(target=runtime_handle_commands_run) { Var(name=block) Add { Var(name=index) Lit(value=1) } } }
          }
        }
      }
    }
  }

  Let(name=runtime_arg_string) {
    Fn(params=args,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=args) } }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              Call(target=runtime_attr_string) {
                ChildAt { Var(name=args) Var(name=index) }
                Lit(value="value")
                Lit(value=0)
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_arg_int) {
    Fn(params=args,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=args) } }
          Block { Return { Lit(value=0) } }
          Block {
            Return {
              Call(target=runtime_attr_int) {
                ChildAt { Var(name=args) Var(name=index) }
                Lit(value="value")
                Lit(value=0)
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_attr_string) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=runtime_attr_string) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_attr_int) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value=0) } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueInt { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=runtime_attr_int) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_has_export) {
    Fn(params=program,name,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=program) } }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=child) { ChildAt { Var(name=program) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Export") }
              Block {
                If {
                  Eq { Call(target=runtime_attr_string) { Var(name=child) Lit(value="name") Lit(value=0) } Var(name=name) }
                  Block { Return { Lit(value=true) } }
                  Block {
                    Return {
                      Call(target=runtime_has_export) {
                        Var(name=program)
                        Var(name=name)
                        Add { Var(name=index) Lit(value=1) }
                      }
                    }
                  }
                }
              }
              Block {
                Return {
                  Call(target=runtime_has_export) {
                    Var(name=program)
                    Var(name=name)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=runtime_call_named_export) {
    Fn(params=exportName) {
      Block {
        Let(name=programText) {
          StrConcat {
            Lit(value="Program#rt_call_p1 { Call#rt_call_c1(target=")
            StrConcat {
              Var(name=exportName)
              Lit(value=") { Var#rt_call_v1(name=argv) } }")
            }
          }
        }
        Let(name=parsed) { Call(target=parse.parseDocument) { Var(name=programText) } }
        If {
          Eq { NodeKind { Var(name=parsed) } Lit(value="Program") }
          Block { Return { Call(target=eval.runProgram) { Var(name=parsed) } } }
          Block { Return { Var(name=__program_result) } }
        }
      }
    }
  }

}
