Program {
  Import(path="./str.aos")
  Import(path="./core.aos")

  Let(name=zero) {
    Fn(params=_) {
      Block {
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=one) {
    Fn(params=_) {
      Block {
        Return { Lit(value=1) }
      }
    }
  }

  Let(name=add) {
    Fn(params=a,b) {
      Block {
        Return { Add { Var(name=a) Var(name=b) } }
      }
    }
  }

  Let(name=inc) {
    Fn(params=value) {
      Block {
        Return { Add { Var(name=value) Lit(value=1) } }
      }
    }
  }

  Let(name=dec) {
    Fn(params=value) {
      Block {
        Return { Add { Var(name=value) Lit(value=-1) } }
      }
    }
  }

  Let(name=negPositiveLoop) {
    Fn(params=value,acc) {
      Block {
        If {
          Eq { Var(name=value) Lit(value=0) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=negPositiveLoop) {
                Add { Var(name=value) Lit(value=-1) }
                Add { Var(name=acc) Lit(value=-1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=negNegativeLoop) {
    Fn(params=value,acc) {
      Block {
        If {
          Eq { Var(name=value) Lit(value=0) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=negNegativeLoop) {
                Add { Var(name=value) Lit(value=1) }
                Add { Var(name=acc) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=sub) {
    Fn(params=a,b) {
      Block {
        Return {
          Sub {
            Var(name=a)
            Var(name=b)
          }
        }
      }
    }
  }

  Let(name=mulPositiveLoop) {
    Fn(params=a,b,acc) {
      Block {
        If {
          Eq { Var(name=b) Lit(value=0) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=mulPositiveLoop) {
                Var(name=a)
                Add { Var(name=b) Lit(value=-1) }
                Add { Var(name=acc) Var(name=a) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=mul) {
    Fn(params=a,b) {
      Block {
        Return {
          Mul {
            Var(name=a)
            Var(name=b)
          }
        }
      }
    }
  }

  Let(name=natLt) {
    Fn(params=a,b) {
      Block {
        If {
          Eq { Var(name=a) Var(name=b) }
          Block { Return { Lit(value=false) } }
          Block {
            If {
              Eq { Var(name=a) Lit(value=0) }
              Block { Return { Lit(value=true) } }
              Block {
                If {
                  Eq { Var(name=b) Lit(value=0) }
                  Block { Return { Lit(value=false) } }
                  Block {
                    Return {
                      Call(target=natLt) {
                        Add { Var(name=a) Lit(value=-1) }
                        Add { Var(name=b) Lit(value=-1) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=textLen) {
    Fn(params=textValue) {
      Block {
        If {
          Eq { Var(name=textValue) Lit(value="") }
          Block { Return { Lit(value=0) } }
          Block {
            Return {
              Add {
                Lit(value=1)
                Call(target=textLen) {
                  Call(target=remove) {
                    Var(name=textValue)
                    Lit(value=0)
                    Lit(value=1)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=textFirst) {
    Fn(params=textValue) {
      Block {
        Return {
          Call(target=substring) {
            Var(name=textValue)
            Lit(value=0)
            Lit(value=1)
          }
        }
      }
    }
  }

  Let(name=textRest) {
    Fn(params=textValue) {
      Block {
        Return {
          Call(target=remove) {
            Var(name=textValue)
            Lit(value=0)
            Lit(value=1)
          }
        }
      }
    }
  }

  Let(name=isNegativeText) {
    Fn(params=textValue) {
      Block {
        If {
          Eq { Var(name=textValue) Lit(value="") }
          Block { Return { Lit(value=false) } }
          Block {
            Return {
              Eq {
                Call(target=textFirst) { Var(name=textValue) }
                Lit(value="-")
              }
            }
          }
        }
      }
    }
  }

  Let(name=absText) {
    Fn(params=textValue) {
      Block {
        If {
          Call(target=isNegativeText) { Var(name=textValue) }
          Block {
            Return { Call(target=textRest) { Var(name=textValue) } }
          }
          Block { Return { Var(name=textValue) } }
        }
      }
    }
  }

  Let(name=positiveTextLt) {
    Fn(params=aText,bText) {
      Block {
        If {
          Eq { Var(name=aText) Var(name=bText) }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=aLen) { Call(target=textLen) { Var(name=aText) } }
            Let(name=bLen) { Call(target=textLen) { Var(name=bText) } }
            If {
              Eq { Var(name=aLen) Var(name=bLen) }
              Block {
                Let(name=aDigit) {
                  Call(target=digitValue) {
                    Call(target=textFirst) { Var(name=aText) }
                  }
                }
                Let(name=bDigit) {
                  Call(target=digitValue) {
                    Call(target=textFirst) { Var(name=bText) }
                  }
                }
                If {
                  Eq { Var(name=aDigit) Var(name=bDigit) }
                  Block {
                    Return {
                      Call(target=positiveTextLt) {
                        Call(target=textRest) { Var(name=aText) }
                        Call(target=textRest) { Var(name=bText) }
                      }
                    }
                  }
                  Block {
                    Return { Call(target=natLt) { Var(name=aDigit) Var(name=bDigit) } }
                  }
                }
              }
              Block {
                Return { Call(target=natLt) { Var(name=aLen) Var(name=bLen) } }
              }
            }
          }
        }
      }
    }
  }

  Let(name=isZero) {
    Fn(params=value) {
      Block {
        Return { Call(target=equals) { Var(name=value) Lit(value=0) } }
      }
    }
  }

  Let(name=isNegative) {
    Fn(params=value) {
      Block {
        Return { Call(target=lt) { Var(name=value) Lit(value=0) } }
      }
    }
  }

  Let(name=isPositive) {
    Fn(params=value) {
      Block {
        Return { Call(target=gt) { Var(name=value) Lit(value=0) } }
      }
    }
  }

  Let(name=isNonNegative) {
    Fn(params=value) {
      Block {
        Return { Call(target=gte) { Var(name=value) Lit(value=0) } }
      }
    }
  }

  Let(name=lt) {
    Fn(params=a,b) {
      Block {
        Return {
          Lt {
            Var(name=a)
            Var(name=b)
          }
        }
      }
    }
  }

  Let(name=lte) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=lt) { Var(name=a) Var(name=b) }
          Block { Return { Lit(value=true) } }
          Block { Return { Call(target=equals) { Var(name=a) Var(name=b) } } }
        }
      }
    }
  }

  Let(name=gt) {
    Fn(params=a,b) {
      Block {
        Return { Call(target=lt) { Var(name=b) Var(name=a) } }
      }
    }
  }

  Let(name=gte) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=gt) { Var(name=a) Var(name=b) }
          Block { Return { Lit(value=true) } }
          Block { Return { Call(target=equals) { Var(name=a) Var(name=b) } } }
        }
      }
    }
  }

  Let(name=toString) {
    Fn(params=value) {
      Block {
        Return { ToString { Var(name=value) } }
      }
    }
  }

  Let(name=negate) {
    Fn(params=value) {
      Block {
        Return {
          Sub {
            Lit(value=0)
            Var(name=value)
          }
        }
      }
    }
  }

  Let(name=abs) {
    Fn(params=value) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Lit(value=0) }
          Block { Return { Call(target=negate) { Var(name=value) } } }
          Block { Return { Var(name=value) } }
        }
      }
    }
  }

  Let(name=sign) {
    Fn(params=value) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Lit(value=0) }
          Block { Return { Lit(value=-1) } }
          Block {
            If {
              Eq { Var(name=value) Lit(value=0) }
              Block { Return { Lit(value=0) } }
              Block { Return { Lit(value=1) } }
            }
          }
        }
      }
    }
  }

  Let(name=min) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=lt) { Var(name=a) Var(name=b) }
          Block { Return { Var(name=a) } }
          Block { Return { Var(name=b) } }
        }
      }
    }
  }

  Let(name=max) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=lt) { Var(name=a) Var(name=b) }
          Block { Return { Var(name=b) } }
          Block { Return { Var(name=a) } }
        }
      }
    }
  }

  Let(name=clamp) {
    Fn(params=value,minimum,maximum) {
      Block {
        Let(name=lowerBounded) {
          Call(target=max) {
            Var(name=value)
            Var(name=minimum)
          }
        }
        Return {
          Call(target=min) {
            Var(name=lowerBounded)
            Var(name=maximum)
          }
        }
      }
    }
  }

  Let(name=betweenInclusive) {
    Fn(params=value,minimum,maximum) {
      Block {
        If {
          Call(target=gte) {
            Var(name=value)
            Var(name=minimum)
          }
          Block {
            Return {
              Call(target=lte) {
                Var(name=value)
                Var(name=maximum)
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=betweenExclusive) {
    Fn(params=value,minimum,maximum) {
      Block {
        If {
          Call(target=gt) { Var(name=value) Var(name=minimum) }
          Block { Return { Call(target=lt) { Var(name=value) Var(name=maximum) } } }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=compare) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=lt) { Var(name=a) Var(name=b) }
          Block { Return { Lit(value=-1) } }
          Block {
            If {
              Call(target=gt) { Var(name=a) Var(name=b) }
              Block { Return { Lit(value=1) } }
              Block { Return { Lit(value=0) } }
            }
          }
        }
      }
    }
  }

  Let(name=divPositiveLoop) {
    Fn(params=value,step,acc) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Var(name=step) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=divPositiveLoop) {
                Call(target=sub) { Var(name=value) Var(name=step) }
                Var(name=step)
                Add { Var(name=acc) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=modPositiveLoop) {
    Fn(params=value,step) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Var(name=step) }
          Block { Return { Var(name=value) } }
          Block {
            Return {
              Call(target=modPositiveLoop) {
                Call(target=sub) { Var(name=value) Var(name=step) }
                Var(name=step)
              }
            }
          }
        }
      }
    }
  }

  Let(name=div) {
    Fn(params=a,b) {
      Block {
        Return {
          Div {
            Var(name=a)
            Var(name=b)
          }
        }
      }
    }
  }

  Let(name=mod) {
    Fn(params=a,b) {
      Block {
        Return {
          Mod {
            Var(name=a)
            Var(name=b)
          }
        }
      }
    }
  }

  Let(name=powPositiveLoop) {
    Fn(params=base,exponent,acc) {
      Block {
        If {
          Eq { Var(name=exponent) Lit(value=0) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=powPositiveLoop) {
                Var(name=base)
                Add { Var(name=exponent) Lit(value=-1) }
                Call(target=mul) { Var(name=acc) Var(name=base) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=pow) {
    Fn(params=base,exponent) {
      Block {
        Return {
          Pow {
            Var(name=base)
            Var(name=exponent)
          }
        }
      }
    }
  }

  Let(name=floor) {
    Fn(params=value) { Block { Return { Var(name=value) } } }
  }

  Let(name=ceil) {
    Fn(params=value) { Block { Return { Var(name=value) } } }
  }

  Let(name=round) {
    Fn(params=value) { Block { Return { Var(name=value) } } }
  }

  Let(name=truncate) {
    Fn(params=value) { Block { Return { Var(name=value) } } }
  }


  Let(name=digitValue) {
    Fn(params=ch) {
      Block {
        If {
          Eq { Var(name=ch) Lit(value="0") }
          Block { Return { Lit(value=0) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="1") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="2") }
          Block { Return { Lit(value=2) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="3") }
          Block { Return { Lit(value=3) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="4") }
          Block { Return { Lit(value=4) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="5") }
          Block { Return { Lit(value=5) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="6") }
          Block { Return { Lit(value=6) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="7") }
          Block { Return { Lit(value=7) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="8") }
          Block { Return { Lit(value=8) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="9") }
          Block { Return { Lit(value=9) } }
          Block { Return { Lit(value=-1) } }
        }
      }
    }
  }

  Let(name=parseWholeAt) {
    Fn(params=text,index,acc) {
      Block {
        Let(name=ch) {
          Call(target=substring) {
            Var(name=text)
            Var(name=index)
            Lit(value=1)
          }
        }
        If {
          Eq { Var(name=ch) Lit(value="") }
          Block { Return { Var(name=acc) } }
          Block {
            Let(name=digit) { Call(target=digitValue) { Var(name=ch) } }
            If {
              Eq { Var(name=digit) Lit(value=-1) }
              Block { Return { Lit(value=-1) } }
              Block {
                Return {
                  Call(target=parseWholeAt) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Add {
                      Call(target=mul) {
                        Var(name=acc)
                        Lit(value=10)
                      }
                      Var(name=digit)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=isWholeString) {
    Fn(params=text) {
      Block {
        If {
          Eq { Var(name=text) Lit(value="") }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=parsed) {
              Call(target=parseWholeAt) {
                Var(name=text)
                Lit(value=0)
                Lit(value=0)
              }
            }
            If {
              Eq { Var(name=parsed) Lit(value=-1) }
              Block { Return { Lit(value=false) } }
              Block { Return { Lit(value=true) } }
            }
          }
        }
      }
    }
  }

  Let(name=parseWholeOr) {
    Fn(params=text,fallback) {
      Block {
        Let(name=parsed) {
          Call(target=parseWholeAt) {
            Var(name=text)
            Lit(value=0)
            Lit(value=0)
          }
        }
        If {
          Eq { Var(name=parsed) Lit(value=-1) }
          Block { Return { Var(name=fallback) } }
          Block { Return { Var(name=parsed) } }
        }
      }
    }
  }

  Let(name=parseSignedWholeCore) {
    Fn(params=text,index,negative) {
      Block {
        Let(name=parsed) {
          Call(target=parseWholeAt) {
            Var(name=text)
            Var(name=index)
            Lit(value=0)
          }
        }
        If {
          Eq { Var(name=parsed) Lit(value=-1) }
          Block { Return { Lit(value=-1) } }
          Block {
            If {
              Var(name=negative)
              Block {
                Return {
                  Call(target=negate) { Var(name=parsed) }
                }
              }
              Block { Return { Var(name=parsed) } }
            }
          }
        }
      }
    }
  }

  Let(name=isSignedWholeString) {
    Fn(params=text) {
      Block {
        Let(name=first) {
          Call(target=substring) {
            Var(name=text)
            Lit(value=0)
            Lit(value=1)
          }
        }
        If {
          Eq { Var(name=first) Lit(value="-") }
          Block {
            If {
              Eq {
                Call(target=substring) {
                  Var(name=text)
                  Lit(value=1)
                  Lit(value=1)
                }
                Lit(value="")
              }
              Block { Return { Lit(value=false) } }
              Block {
                Return {
                  Call(target=isWholeString) {
                    Call(target=substring) {
                      Var(name=text)
                      Lit(value=1)
                      Call(target=sub) {
                        Call(target=textLen) { Var(name=text) }
                        Lit(value=1)
                      }
                    }
                  }
                }
              }
            }
          }
          Block { Return { Call(target=isWholeString) { Var(name=text) } } }
        }
      }
    }
  }

  Let(name=isNumberString) {
    Fn(params=text) {
      Block { Return { Call(target=isSignedWholeString) { Var(name=text) } } }
    }
  }

  Let(name=parseNumberOr) {
    Fn(params=text,fallback) {
      Block {
        Let(name=first) {
          Call(target=substring) {
            Var(name=text)
            Lit(value=0)
            Lit(value=1)
          }
        }
        If {
          Eq { Var(name=first) Lit(value="-") }
          Block {
            Let(name=rest) {
              Call(target=substring) {
                Var(name=text)
                Lit(value=1)
                Call(target=sub) {
                  Call(target=textLen) { Var(name=text) }
                  Lit(value=1)
                }
              }
            }
            If {
              Call(target=isWholeString) { Var(name=rest) }
              Block {
                Return {
                  Call(target=parseSignedWholeCore) {
                    Var(name=text)
                    Lit(value=1)
                    Lit(value=true)
                  }
                }
              }
              Block { Return { Var(name=fallback) } }
            }
          }
          Block {
            If {
              Call(target=isWholeString) { Var(name=text) }
              Block {
                Return {
                  Call(target=parseSignedWholeCore) {
                    Var(name=text)
                    Lit(value=0)
                    Lit(value=false)
                  }
                }
              }
              Block { Return { Var(name=fallback) } }
            }
          }
        }
      }
    }
  }

  Export(name=zero)
  Export(name=one)
  Export(name=add)
  Export(name=inc)
  Export(name=dec)
  Export(name=sub)
  Export(name=mul)
  Export(name=div)
  Export(name=mod)
  Export(name=pow)
  Export(name=isZero)
  Export(name=isNegative)
  Export(name=isPositive)
  Export(name=isNonNegative)
  Export(name=lt)
  Export(name=lte)
  Export(name=gt)
  Export(name=gte)
  Export(name=compare)
  Export(name=toString)
  Export(name=negate)
  Export(name=abs)
  Export(name=sign)
  Export(name=min)
  Export(name=max)
  Export(name=clamp)
  Export(name=betweenInclusive)
  Export(name=betweenExclusive)
  Export(name=floor)
  Export(name=ceil)
  Export(name=round)
  Export(name=truncate)
  Export(name=digitValue)
  Export(name=isWholeString)
  Export(name=parseWholeOr)
  Export(name=isSignedWholeString)
  Export(name=isNumberString)
  Export(name=parseNumberOr)
}
