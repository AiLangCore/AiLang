Program {
  Let(name=write) {
    Fn(params=value) {
      Block {
        Return {
          Call(target=sys.console.write) { Var(name=value) }
        }
      }
    }
  }

  Let(name=writeLine) {
    Fn(params=value) {
      Block {
        Return {
          Call(target=sys.console.writeLine) { Var(name=value) }
        }
      }
    }
  }

  Let(name=writeErrLine) {
    Fn(params=value) {
      Block {
        Return {
          Call(target=sys.console.writeErrLine) { Var(name=value) }
        }
      }
    }
  }

  Let(name=print) {
    Fn(params=value) {
      Block {
        Return {
          Call(target=writeLine) { Var(name=value) }
        }
      }
    }
  }

  Let(name=println) {
    Fn(params=value) {
      Block {
        Return {
          Call(target=writeLine) { Var(name=value) }
        }
      }
    }
  }

  Export(name=write)
  Export(name=writeLine)
  Export(name=writeErrLine)
  Export(name=print)
  Export(name=println)
}
