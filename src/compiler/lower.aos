Program {
  Import(path="block_builder.aos")
  Import(path="block_linker.aos")
  Import(path="lower/constants/expressions.aos")
  Import(path="lower/constants/policy.aos")
  Import(path="lower/constants/locals.aos")
  Import(path="lower/constants/match.aos")
  Import(path="lower/constants/literals.aos")
  Import(path="lower/bindings/scope.aos")
  Import(path="lower/bindings/symbols.aos")
  Import(path="lower/bindings/parameters.aos")
  Import(path="lower/bindings/locals.aos")
  Import(path="lower/bindings/calls.aos")
  Import(path="lower/returns/expressions.aos")
  Import(path="lower/returns/routing.aos")
  Import(path="lower/returns/parameters.aos")
  Import(path="lower/returns/void.aos")
  Import(path="lower/control/value_if.aos")
  Import(path="lower/control/native_branches.aos")
  Import(path="lower/control/statement_binding.aos")
  Import(path="lower/control/statement_return.aos")
  Import(path="lower/control/statement_if.aos")
  Import(path="lower/expressions/policy.aos")
  Import(path="lower/expressions/byte_opcodes.aos")
  Import(path="lower/expressions/map_opcodes.aos")
  Import(path="lower/expressions/opcodes.aos")
  Import(path="lower/expressions/variadic.aos")
  Import(path="lower/expressions/syscalls.aos")
  Import(path="lower/expressions/map_literals.aos")
  Import(path="lower/expressions/emission.aos")
  Import(path="lower/plans/dispatch.aos")
  Import(path="lower/plans/native_records.aos")
  Import(path="lower/plans/if_calls.aos")
  Import(path="lower/records/index.aos")
  Import(path="lower/records/lookup.aos")
  Export(name=lower.collectFunctionRecords)
  Export(name=lower.emitObjectConstants)
  Export(name=lower.emitObjectFunctionBody)
  Export(name=lower.emitStructuralReturnIntPlan)
  Export(name=lower.emitStructuralRecordPlan)
  Export(name=lower.emitStructuralPlans)
  Export(name=lower.emitStructuralPlansWithSymbols)
  Export(name=lower.emitStructuralRecordPlanWithSymbols)
  Export(name=lower.emitStructuralReturnLiteralPlan)
  Export(name=lower.emitStructuralLocalBinaryRecordPlan)
  Export(name=lower.emitStructuralLocalCallRecordPlan)
  Export(name=lower.emitStructuralLocalReturnRecordPlan)
  Export(name=lower.emitStructuralCallRecordPlan)
  Export(name=lower.emitStructuralParameterBinaryRecordPlan)
  Export(name=lower.emitStructuralIfRecordPlan)
  Export(name=lower.emitStructuralLocalIfRecordPlan)
  Export(name=lower.emitStructuralParameterIfPlan)
  Export(name=lower.emitStructuralLiteralMatchRecordPlan)
  Export(name=lower.emitStructuralLocalMatchRecordPlan)
  Export(name=lower.emitStructuralMatchRecordPlan)

  Let(name=lower.emitStructuralReturnIntPlan) {
    Fn(params=name,symbol,value) {
      Block {
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Lit(value="") Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withConstant) { Call(target=blockBuilder.emit) { Var(name=context) Lit(value="CONST") StrConcat { Lit(value="int:") Var(name=value) } } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withConstant) } }
        Let(name=block) { Call(target=blockBuilder.seal) { Var(name=terminated) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Var(name=block) } } }
      }
    }
  }

  Let(name=lower.emitStructuralReturnLiteralPlan) {
    Fn(params=name,symbol,params,target) {
      Block {
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
        Let(name=withConstant) { Call(target=blockBuilder.emit) { Var(name=withParams) Lit(value="CONST") Var(name=target) } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withConstant) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.emitStructuralRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        If {
          Eq { ChildCount { Var(name=body) } Lit(value=2) }
          Block { Return { Call(target=lower.emitStructuralTwoStatementRecordPlan) { Var(name=record) } } }
          Block {
            If {
              Eq { ChildCount { Var(name=body) } Lit(value=1) }
              Block {
                Let(name=node) { ChildAt { Var(name=body) Lit(value=0) } }
                If {
                  Eq { NodeKind { Var(name=node) } Lit(value="If") }
                  Block { Return { Call(target=lower.emitStructuralIfRecordPlan) { Var(name=record) } } }
                  Block {
                    If {
                      Eq { NodeKind { Var(name=node) } Lit(value="Return") }
                      Block { Return { Call(target=lower.emitStructuralSingleReturnRecordPlan) { Var(name=record) Var(name=node) } } }
                      Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER022") Lit(value="Structural lowerer requires a Return or If body.") NodeId { Var(name=node) } } } }
                    }
                  }
                }
              }
              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER023") Lit(value="Structural lowerer requires a supported body.") NodeId { Var(name=body) } } } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralSingleReturnRecordPlan) {
    Fn(params=record,returnNode) {
      Block {
        If {
          Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
          Block {
            Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
              Block {
                Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
                Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
                Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
                Return { Call(target=lower.emitStructuralReturnLiteralPlan) { Var(name=name) Var(name=symbol) Var(name=params) Call(target=lower.literalConstantTarget) { Var(name=value) } } }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=value) } Lit(value="Call") }
                  Block { Return { Call(target=lower.emitStructuralCallRecordPlan) { Var(name=record) } } }
                  Block {
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Match") }
                      Block { Return { Call(target=lower.emitStructuralMatchRecordPlan) { Var(name=record) } } }
                      Block {
                        If {
                          Eq { NodeKind { Var(name=value) } Lit(value="Var") }
                          Block { Return { Call(target=lower.emitStructuralParameterReturnRecordPlan) { Var(name=record) } } }
                          Block { Return { Call(target=lower.emitStructuralParameterBinaryRecordPlan) { Var(name=record) } } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER021") Lit(value="Structural lowerer requires one return value.") NodeId { Var(name=returnNode) } } } }
        }
      }
    }
  }

  Let(name=lower.emitStructuralLocalBinaryRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=local) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=localName) { Call(target=lower.getAttr) { Var(name=local) Lit(value="name") Lit(value=0) } }
        Let(name=localSlot) { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } }
        Let(name=init) { ChildAt { Var(name=local) Lit(value=0) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=1) } }
        Let(name=operationNode) { ChildAt { Var(name=returnNode) Lit(value=0) } }
        Let(name=operation) { Call(target=lower.structuralBinaryOp) { Var(name=operationNode) } }
        Let(name=left) { ChildAt { Var(name=operationNode) Lit(value=0) } }
        Let(name=right) { ChildAt { Var(name=operationNode) Lit(value=1) } }
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="local") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Var(name=localSlot) Lit(value=1) } } }
        Let(name=withInit) { Call(target=lower.appendStructuralValue) { Var(name=withParams) Var(name=init) Var(name=params) Lit(value="") Lit(value=-1) } }
        Let(name=withStore) { Call(target=blockBuilder.emit) { Var(name=withInit) Lit(value="STORE_LOCAL") ToString { Var(name=localSlot) } } }
        Let(name=withLeft) { Call(target=lower.appendStructuralValue) { Var(name=withStore) Var(name=left) Var(name=params) Var(name=localName) Var(name=localSlot) } }
        Let(name=withRight) { Call(target=lower.appendStructuralValue) { Var(name=withLeft) Var(name=right) Var(name=params) Var(name=localName) Var(name=localSlot) } }
        Let(name=withOperation) { Call(target=blockBuilder.emit) { Var(name=withRight) Var(name=operation) Lit(value="") } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withOperation) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.emitStructuralTwoStatementRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=1) } }
        If {
          Eq { NodeKind { Var(name=returnNode) } Lit(value="If") }
          Block { Return { Call(target=lower.emitStructuralLocalIfRecordPlan) { Var(name=record) } } }
          Block {
            Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=value) } Lit(value="Match") }
              Block { Return { Call(target=lower.emitStructuralLocalMatchRecordPlan) { Var(name=record) } } }
              Block {
                If {
                  Eq { NodeKind { Var(name=value) } Lit(value="Call") }
                  Block { Return { Call(target=lower.emitStructuralLocalCallRecordPlan) { Var(name=record) } } }
                  Block {
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Var") }
                      Block { Return { Call(target=lower.emitStructuralLocalReturnRecordPlan) { Var(name=record) } } }
                      Block { Return { Call(target=lower.emitStructuralLocalBinaryRecordPlan) { Var(name=record) } } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralCallRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=modulePath) { AttrValueString { ChildAt { Var(name=record) Lit(value=0) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=call) { ChildAt { Var(name=returnNode) Lit(value=0) } }
        Let(name=target) { Call(target=lower.getAttr) { Var(name=call) Lit(value="target") Lit(value=0) } }
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
        Let(name=withArgs) { Call(target=lower.appendStructuralCallArguments) { Var(name=withParams) Var(name=call) Var(name=params) Lit(value="") Lit(value=-1) Lit(value=0) } }
        Let(name=withCall) { Call(target=blockBuilder.emit) { Var(name=withArgs) Lit(value="CALL") StrConcat { Var(name=modulePath) StrConcat { Lit(value="::") Var(name=target) } } } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withCall) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.emitStructuralCallRecordPlanWithSymbols) {
    Fn(params=record,records) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=call) { ChildAt { Var(name=returnNode) Lit(value=0) } }
        Let(name=targetName) { Call(target=lower.getAttr) { Var(name=call) Lit(value="target") Lit(value=0) } }
        Let(name=targetSymbol) { Call(target=lower.resolveStructuralCallSymbol) { Var(name=records) Var(name=targetName) Lit(value=0) } }
        If {
          Eq { NodeKind { Var(name=targetSymbol) } Lit(value="Err") }
          Block { Return { Var(name=targetSymbol) } }
          Block {
            Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
            Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
            Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
            Let(name=withArgs) { Call(target=lower.appendStructuralCallArguments) { Var(name=withParams) Var(name=call) Var(name=params) Lit(value="") Lit(value=-1) Lit(value=0) } }
            Let(name=withCall) { Call(target=blockBuilder.emit) { Var(name=withArgs) Lit(value="CALL") AttrValueString { Var(name=targetSymbol) Lit(value=0) } } }
            Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withCall) } }
            Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralStdoutThenReturnRecordPlanWithSymbols) {
    Fn(params=record,records) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=stdoutCall) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=message) { ChildAt { Var(name=stdoutCall) Lit(value=0) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=1) } }
        Let(name=returnCall) { ChildAt { Var(name=returnNode) Lit(value=0) } }
        Let(name=targetName) { Call(target=lower.getAttr) { Var(name=returnCall) Lit(value="target") Lit(value=0) } }
        Let(name=targetSymbol) { Call(target=lower.resolveStructuralCallSymbol) { Var(name=records) Var(name=targetName) Lit(value=0) } }
        If {
          Eq { NodeKind { Var(name=targetSymbol) } Lit(value="Err") }
          Block { Return { Var(name=targetSymbol) } }
          Block {
            Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
            Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
            Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
            Let(name=withTarget) { Call(target=blockBuilder.emit) { Var(name=withParams) Lit(value="CONST") Lit(value="string:sys.stdout.writeLine") } }
            Let(name=withMessage) { Call(target=lower.appendStructuralValue) { Var(name=withTarget) Var(name=message) Var(name=params) Lit(value="") Lit(value=-1) } }
            Let(name=withSyscall) { Call(target=blockBuilder.emit) { Var(name=withMessage) Lit(value="CALL_SYS") Lit(value="1") } }
            Let(name=withPop) { Call(target=blockBuilder.emit) { Var(name=withSyscall) Lit(value="POP") Lit(value="") } }
            Let(name=withArgs) { Call(target=lower.appendStructuralCallArguments) { Var(name=withPop) Var(name=returnCall) Var(name=params) Lit(value="") Lit(value=-1) Lit(value=0) } }
            Let(name=withCall) { Call(target=blockBuilder.emit) { Var(name=withArgs) Lit(value="CALL") AttrValueString { Var(name=targetSymbol) Lit(value=0) } } }
            Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withCall) } }
            Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralLocalCallRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=modulePath) { AttrValueString { ChildAt { Var(name=record) Lit(value=0) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=local) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=localName) { Call(target=lower.getAttr) { Var(name=local) Lit(value="name") Lit(value=0) } }
        Let(name=localSlot) { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } }
        Let(name=init) { ChildAt { Var(name=local) Lit(value=0) } }
        Let(name=call) { ChildAt { ChildAt { Var(name=body) Lit(value=1) } Lit(value=0) } }
        Let(name=target) { Call(target=lower.getAttr) { Var(name=call) Lit(value="target") Lit(value=0) } }
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="local") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Var(name=localSlot) Lit(value=1) } } }
        Let(name=withInit) { Call(target=lower.appendStructuralValue) { Var(name=withParams) Var(name=init) Var(name=params) Lit(value="") Lit(value=-1) } }
        Let(name=withStore) { Call(target=blockBuilder.emit) { Var(name=withInit) Lit(value="STORE_LOCAL") ToString { Var(name=localSlot) } } }
        Let(name=withArgs) { Call(target=lower.appendStructuralCallArguments) { Var(name=withStore) Var(name=call) Var(name=params) Var(name=localName) Var(name=localSlot) Lit(value=0) } }
        Let(name=withCall) { Call(target=blockBuilder.emit) { Var(name=withArgs) Lit(value="CALL") StrConcat { Var(name=modulePath) StrConcat { Lit(value="::") Var(name=target) } } } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withCall) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.emitStructuralLocalReturnRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=local) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=localName) { Call(target=lower.getAttr) { Var(name=local) Lit(value="name") Lit(value=0) } }
        Let(name=localSlot) { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } }
        Let(name=init) { ChildAt { Var(name=local) Lit(value=0) } }
        Let(name=returnValue) { ChildAt { ChildAt { Var(name=body) Lit(value=1) } Lit(value=0) } }
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="local") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Var(name=localSlot) Lit(value=1) } } }
        Let(name=withInit) { Call(target=lower.appendStructuralValue) { Var(name=withParams) Var(name=init) Var(name=params) Lit(value="") Lit(value=-1) } }
        Let(name=withStore) { Call(target=blockBuilder.emit) { Var(name=withInit) Lit(value="STORE_LOCAL") ToString { Var(name=localSlot) } } }
        Let(name=withReturnValue) { Call(target=lower.appendStructuralValue) { Var(name=withStore) Var(name=returnValue) Var(name=params) Var(name=localName) Var(name=localSlot) } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withReturnValue) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.appendStructuralCallArguments) {
    Fn(params=context,call,params,localName,localSlot,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=call) } }
          Block { Return { Var(name=context) } }
          Block {
            Let(name=argument) { ChildAt { Var(name=call) Var(name=index) } }
