                If {
                  Eq { NodeKind { Var(name=condition) } Lit(value="Lit") }
                  Block { Return { Call(target=lower.emitStructuralLocalLiteralIfCallsPlan) { Var(name=name) Var(name=symbol) Var(name=params) Var(name=records) Var(name=local) Var(name=condition) Var(name=thenBlock) Var(name=elseBlock) } } }
                  Block { Return { Call(target=lower.emitStructuralLocalBoundIfCallsPlan) { Var(name=name) Var(name=symbol) Var(name=params) Var(name=records) Var(name=local) Var(name=condition) Var(name=thenBlock) Var(name=elseBlock) } } }
                }
              }
              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER029") Lit(value="Structural local If call branches currently require a single Call return.") NodeId { Var(name=elseBlock) } } } }
            }
