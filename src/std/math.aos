          Block { Return { Var(name=b) } }
        }
      }
    }
  }

  Let(name=max) {
    Fn(params=a,b) {
      Block {
        If {
          Call(target=lt) { Var(name=a) Var(name=b) }
          Block { Return { Var(name=b) } }
          Block { Return { Var(name=a) } }
        }
      }
    }
  }

  Let(name=clamp) {
    Fn(params=value,low,high) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Var(name=low) }
          Block { Return { Var(name=low) } }
          Block {
            If {
              Call(target=gt) { Var(name=value) Var(name=high) }
              Block { Return { Var(name=high) } }
              Block { Return { Var(name=value) } }
            }
          }
        }
      }
    }
  }

  Export#std_math_e1(name=add)
  Export#std_math_e2(name=sub)
  Export#std_math_e3(name=mul)
  Export#std_math_e4(name=negate)
  Export#std_math_e5(name=lt)
  Export#std_math_e6(name=lte)
  Export#std_math_e7(name=gte)
  Export(name=gt)
  Export(name=eq)
  Export(name=neq)
  Export#std_math_e8(name=abs)
  Export#std_math_e9(name=halfFloor)
  Export(name=divFloor)
  Export#std_math_e10(name=subAbs)
  Export(name=min)
  Export(name=max)
  Export(name=clamp)
}
