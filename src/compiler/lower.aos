                                                    StrConcat {
                                                      ToString { Var(name=nextInstruction) }
                                                      StrConcat {
                                                        Lit(value=") Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=")
                                                        StrConcat {
                                                          ToString { Add { Var(name=instructionIndex) Lit(value=4) } }
                                                          StrConcat {
                                                            Lit(value=" target=\"")
                                                            StrConcat {
                                                              Call(target=lower.literalConstantTarget) { Var(name=result) }
                                                              StrConcat { Lit(value="\") Inst(op=\"RETURN\") ") Call(target=lower.emitGeneralParameterMatchArms) { Var(name=matchNode) Var(name=slot) Add { Var(name=armIndex) Lit(value=1) } Var(name=nextInstruction) } }
