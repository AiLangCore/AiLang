Program {
  Let(name=format) {
    Fn(params=node) {
      Block {
        Return {
          StrConcat {
            NodeKind { Var(name=node) }
            StrConcat {
              Call(target=formatAttrs) {
                Var(name=node)
                Lit(value=0)
              }
              Call(target=formatChildren) {
                Var(name=node)
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatWithIds) {
    Fn(params=node) {
      Block {
        Return {
          StrConcat {
            StrConcat {
              StrConcat {
                NodeKind { Var(name=node) }
                Lit(value="#")
              }
              NodeId { Var(name=node) }
            }
            StrConcat {
              Call(target=formatAttrs) {
                Var(name=node)
                Lit(value=0)
              }
              Call(target=formatChildrenWithIds) {
                Var(name=node)
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatAttrs) {
    Fn(params=node,index) {
      Block {
        If {
          Eq {
            Var(name=index)
            AttrCount { Var(name=node) }
          }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                StrConcat {
                  StrConcat {
                    StrConcat {
                      StrConcat {
                        StrConcat {
                          If {
                            Eq { Var(name=index) Lit(value=0) }
                            Block { Lit(value="(") }
                            Block { Lit(value=" ") }
                          }
                          AttrKey { Var(name=node) Var(name=index) }
                        }
                        Lit(value="=")
                      }
                      Call(target=formatAttrValue) { Var(name=node) Var(name=index) }
                    }
                    If {
                      Eq {
                        Add { Var(name=index) Lit(value=1) }
                        AttrCount { Var(name=node) }
                      }
                      Block { Lit(value=")") }
                      Block { Lit(value="") }
                    }
                  }
                  Call(target=formatAttrs) {
                    Var(name=node)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
                Lit(value="")
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatAttrValue) {
    Fn(params=node,index) {
      Block {
        If {
          Eq {
            AttrValueKind { Var(name=node) Var(name=index) }
            Lit(value="string")
          }
          Block {
            Return {
              StrConcat {
                Lit(value="\"")
                StrConcat {
                  StrEscape { AttrValueString { Var(name=node) Var(name=index) } }
                  Lit(value="\"")
                }
              }
            }
          }
          Block {
            If {
              Eq {
                AttrValueKind { Var(name=node) Var(name=index) }
                Lit(value="int")
              }
              Block {
                Return { ToString { AttrValueInt { Var(name=node) Var(name=index) } } }
              }
              Block {
                If {
                  Eq {
                    AttrValueKind { Var(name=node) Var(name=index) }
                    Lit(value="bool")
                  }
                  Block {
                    If {
                      AttrValueBool { Var(name=node) Var(name=index) }
                      Block { Return { Lit(value="true") } }
                      Block { Return { Lit(value="false") } }
                    }
                  }
                  Block {
                    Return { AttrValueString { Var(name=node) Var(name=index) } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatChildren) {
    Fn(params=node) {
      Block {
        If {
          Eq {
            ChildCount { Var(name=node) }
            Lit(value=0)
          }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                Lit(value=" { ")
                StrConcat {
                  Call(target=format) { ChildAt { Var(name=node) Lit(value=0) } }
                  StrConcat {
                    Call(target=formatChildrenTail) {
                      Var(name=node)
                      Lit(value=1)
                      ChildCount { Var(name=node) }
                    }
                    Lit(value=" }")
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatChildrenTail) {
    Fn(params=node,index,count) {
      Block {
        If {
          Eq { Var(name=index) Var(name=count) }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                Lit(value=" ")
                StrConcat {
                  Call(target=format) { ChildAt { Var(name=node) Var(name=index) } }
                  Call(target=formatChildrenTail) {
                    Var(name=node)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=count)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatChildrenWithIds) {
    Fn(params=node) {
      Block {
        If {
          Eq {
            ChildCount { Var(name=node) }
            Lit(value=0)
          }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                Lit(value=" { ")
                StrConcat {
                  Call(target=formatWithIds) { ChildAt { Var(name=node) Lit(value=0) } }
                  StrConcat {
                    Call(target=formatChildrenWithIdsTail) {
                      Var(name=node)
                      Lit(value=1)
                      ChildCount { Var(name=node) }
                    }
                    Lit(value=" }")
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatChildrenWithIdsTail) {
    Fn(params=node,index,count) {
      Block {
        If {
          Eq { Var(name=index) Var(name=count) }
          Block { Return { Lit(value="") } }
          Block {
            Return {
              StrConcat {
                Lit(value=" ")
                StrConcat {
                  Call(target=formatWithIds) { ChildAt { Var(name=node) Var(name=index) } }
                  Call(target=formatChildrenWithIdsTail) {
                    Var(name=node)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=count)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
