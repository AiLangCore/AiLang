        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=local) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=ifNode) { ChildAt { Var(name=body) Lit(value=1) } }
        Let(name=condition) { ChildAt { Var(name=ifNode) Lit(value=0) } }
        Let(name=thenBlock) { ChildAt { Var(name=ifNode) Lit(value=1) } }
        Let(name=elseBlock) { ChildAt { Var(name=ifNode) Lit(value=2) } }
        If {
