Program {
  Import(path="block_builder.aos")
  Import(path="block_linker.aos")
  Export(name=lower.collectFunctionRecords)
  Export(name=lower.emitObjectConstants)
  Export(name=lower.emitObjectFunctionBody)
  Export(name=lower.emitStructuralReturnIntPlan)
  Export(name=lower.emitStructuralRecordPlan)
  Export(name=lower.emitStructuralPlans)
  Export(name=lower.emitStructuralPlansWithSymbols)
  Export(name=lower.emitStructuralRecordPlanWithSymbols)
  Export(name=lower.emitStructuralReturnLiteralPlan)
  Export(name=lower.emitStructuralLocalBinaryRecordPlan)
  Export(name=lower.emitStructuralLocalCallRecordPlan)
  Export(name=lower.emitStructuralLocalReturnRecordPlan)
  Export(name=lower.emitStructuralCallRecordPlan)
  Export(name=lower.emitStructuralParameterBinaryRecordPlan)
  Export(name=lower.emitStructuralIfRecordPlan)
  Export(name=lower.emitStructuralLocalIfRecordPlan)
  Export(name=lower.emitStructuralParameterIfPlan)
  Export(name=lower.emitStructuralLiteralMatchRecordPlan)
  Export(name=lower.emitStructuralLocalMatchRecordPlan)
  Export(name=lower.emitStructuralMatchRecordPlan)

  Let(name=lower.emitStructuralReturnIntPlan) {
    Fn(params=name,symbol,value) {
      Block {
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Lit(value="") Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withConstant) { Call(target=blockBuilder.emit) { Var(name=context) Lit(value="CONST") StrConcat { Lit(value="int:") Var(name=value) } } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withConstant) } }
        Let(name=block) { Call(target=blockBuilder.seal) { Var(name=terminated) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Var(name=block) } } }
      }
    }
  }

  Let(name=lower.emitStructuralReturnLiteralPlan) {
    Fn(params=name,symbol,target) {
      Block {
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Lit(value="") Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withConstant) { Call(target=blockBuilder.emit) { Var(name=context) Lit(value="CONST") Var(name=target) } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withConstant) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.emitStructuralRecordPlan) {
    Fn(params=record) {
      Block {
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        If {
          Eq { ChildCount { Var(name=body) } Lit(value=2) }
          Block { Return { Call(target=lower.emitStructuralTwoStatementRecordPlan) { Var(name=record) } } }
          Block {
            If {
              Eq { ChildCount { Var(name=body) } Lit(value=1) }
              Block {
                Let(name=node) { ChildAt { Var(name=body) Lit(value=0) } }
                If {
                  Eq { NodeKind { Var(name=node) } Lit(value="If") }
                  Block { Return { Call(target=lower.emitStructuralIfRecordPlan) { Var(name=record) } } }
                  Block {
                    If {
                      Eq { NodeKind { Var(name=node) } Lit(value="Return") }
                      Block { Return { Call(target=lower.emitStructuralSingleReturnRecordPlan) { Var(name=record) Var(name=node) } } }
                      Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER022") Lit(value="Structural lowerer requires a Return or If body.") NodeId { Var(name=node) } } } }
                    }
                  }
                }
              }
              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER023") Lit(value="Structural lowerer requires a supported body.") NodeId { Var(name=body) } } } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralSingleReturnRecordPlan) {
    Fn(params=record,returnNode) {
      Block {
        If {
          Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
          Block {
            Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
              Block {
                Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
                Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
                Return { Call(target=lower.emitStructuralReturnLiteralPlan) { Var(name=name) Var(name=symbol) Call(target=lower.literalConstantTarget) { Var(name=value) } } }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=value) } Lit(value="Call") }
                  Block { Return { Call(target=lower.emitStructuralCallRecordPlan) { Var(name=record) } } }
                  Block {
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Match") }
                      Block { Return { Call(target=lower.emitStructuralMatchRecordPlan) { Var(name=record) } } }
                      Block {
                        If {
                          Eq { NodeKind { Var(name=value) } Lit(value="Var") }
                          Block { Return { Call(target=lower.emitStructuralParameterReturnRecordPlan) { Var(name=record) } } }
                          Block { Return { Call(target=lower.emitStructuralParameterBinaryRecordPlan) { Var(name=record) } } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER021") Lit(value="Structural lowerer requires one return value.") NodeId { Var(name=returnNode) } } } }
        }
      }
    }
  }

  Let(name=lower.isStructuralNativeExpression) {
    Fn(params=expr) {
      Block {
        Let(name=kind) { NodeKind { Var(name=expr) } }
        If {
          Eq { Var(name=kind) Lit(value="StrConcat") }
          Block { Return { Lit(value=true) } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="Eq") }
              Block { Return { Lit(value=true) } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="Lt") }
                  Block { Return { Lit(value=true) } }
                  Block {
                    If {
                      Call(target=lower.isStructuralNumericBinaryExpression) { Var(name=expr) }
                      Block { Return { Lit(value=true) } }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="AttrKey") }
                          Block { Return { Lit(value=true) } }
                          Block {
                            If {
                              Eq { Var(name=kind) Lit(value="AttrValueString") }
                              Block { Return { Lit(value=true) } }
                              Block {
                                If {
                                  Eq { Var(name=kind) Lit(value="ChildCount") }
                                  Block { Return { Lit(value=true) } }
                                  Block {
                                    If {
                                      Eq { Var(name=kind) Lit(value="MakeBlock") }
                                      Block { Return { Lit(value=true) } }
                                      Block {
                                        If {
                                          Eq { Var(name=kind) Lit(value="MakeLitString") }
                                          Block { Return { Lit(value=true) } }
                                          Block {
                                            If {
                                              Eq { Var(name=kind) Lit(value="MakeLitInt") }
                                              Block { Return { Lit(value=true) } }
                                              Block { Return { Eq { Var(name=kind) Lit(value="MakeErr") } } }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStructuralNativeReturnRecordPlan) {
    Fn(params=record,records) {
      Block {
        Let(name=name) { AttrValueString { ChildAt { Var(name=record) Lit(value=1) } Lit(value=0) } }
        Let(name=symbol) { AttrValueString { ChildAt { Var(name=record) Lit(value=2) } Lit(value=0) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
        Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
        Let(name=context) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
        Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=context) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
        Let(name=withValue) { Call(target=lower.appendStructuralNativeExpression) { Var(name=withParams) Var(name=value) Var(name=params) Var(name=records) } }
        Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withValue) } }
        Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } } }
      }
    }
  }

  Let(name=lower.structuralNativeIndexOpcode) {
    Fn(params=kind) {
      Block {
        If {
          Eq { Var(name=kind) Lit(value="AttrKey") }
          Block { Return { Lit(value="ATTR_KEY") } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="AttrValueString") }
              Block { Return { Lit(value="ATTR_VALUE_STRING") } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="AttrValueInt") }
                  Block { Return { Lit(value="ATTR_VALUE_INT") } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="AttrValueKind") }
                      Block { Return { Lit(value="ATTR_VALUE_KIND") } }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="AttrValueBool") }
                          Block { Return { Lit(value="ATTR_VALUE_BOOL") } }
                          Block {
                            If {
                              Eq { Var(name=kind) Lit(value="ChildAt") }
                              Block { Return { Lit(value="CHILD_AT") } }
                              Block { Return { Lit(value="") } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.structuralNativeUnaryOpcode) {
    Fn(params=kind) {
      Block {
        If {
          Eq { Var(name=kind) Lit(value="MakeBlock") }
          Block { Return { Lit(value="MAKE_BLOCK") } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="AttrCount") }
              Block { Return { Lit(value="ATTR_COUNT") } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="ChildCount") }
                  Block { Return { Lit(value="CHILD_COUNT") } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="ValueKind") }
                      Block { Return { Lit(value="VALUE_KIND") } }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="NodeId") }
                          Block { Return { Lit(value="NODE_ID") } }
                          Block {
                            If {
                              Eq { Var(name=kind) Lit(value="NodeKind") }
                              Block { Return { Lit(value="NODE_KIND") } }
                              Block {
                                If {
                                  Eq { Var(name=kind) Lit(value="ToString") }
                                  Block { Return { Lit(value="TO_STRING") } }
                                  Block {
                                    If {
                                      Eq { Var(name=kind) Lit(value="StrEscape") }
                                      Block { Return { Lit(value="STR_ESCAPE") } }
                                      Block {
                                        If {
                                          Eq { Var(name=kind) Lit(value="PairFirst") }
                                          Block { Return { Lit(value="PAIR_FIRST") } }
                                          Block {
                                            If {
                                              Eq { Var(name=kind) Lit(value="PairSecond") }
                                              Block { Return { Lit(value="PAIR_SECOND") } }
                                              Block { Return { Lit(value="") } }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.structuralNativeVariadicOpcode) {
    Fn(params=kind) {
      Block {
        If {
          Eq { Var(name=kind) Lit(value="MakeErr") }
          Block { Return { Lit(value="MAKE_ERR") } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="MakeLitString") }
              Block { Return { Lit(value="MAKE_LIT_STRING") } }
              Block {
            If {
              Eq { Var(name=kind) Lit(value="MakeLitInt") }
              Block { Return { Lit(value="MAKE_LIT_INT") } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="MakePair") }
                  Block { Return { Lit(value="MAKE_PAIR") } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="MakeLitBool") }
                      Block { Return { Lit(value="MAKE_LIT_BOOL") } }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="MakeNode") }
                          Block { Return { Lit(value="MAKE_NODE") } }
                          Block {
                            If {
                              Eq { Var(name=kind) Lit(value="StringSlice") }
                              Block { Return { Lit(value="STR_SUBSTRING") } }
                              Block {
                                If {
                                  Eq { Var(name=kind) Lit(value="StringFind") }
                                  Block { Return { Lit(value="STR_FIND") } }
                                  Block { Return { Lit(value="") } }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.structuralNativeBinaryOpcode) {
    Fn(params=kind) {
      Block {
        If {
          Eq { Var(name=kind) Lit(value="AppendAttr") }
          Block { Return { Lit(value="APPEND_ATTR") } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="AppendChild") }
              Block { Return { Lit(value="APPEND_CHILD") } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="StrConcat") }
                  Block { Return { Lit(value="STR_CONCAT") } }
                  Block { Return { Lit(value="") } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.appendStructuralNativeExpression) {
    Fn(params=context,expr,params,records) {
      Block {
        Let(name=kind) { NodeKind { Var(name=expr) } }
        Let(name=indexOpcode) { Call(target=lower.structuralNativeIndexOpcode) { Var(name=kind) } }
        Let(name=unaryOpcode) { Call(target=lower.structuralNativeUnaryOpcode) { Var(name=kind) } }
        Let(name=variadicOpcode) { Call(target=lower.structuralNativeVariadicOpcode) { Var(name=kind) } }
        Let(name=binaryOpcode) { Call(target=lower.structuralNativeBinaryOpcode) { Var(name=kind) } }
        If {
          Eq { Var(name=kind) Lit(value="Lit") }
          Block { Return { Call(target=lower.appendStructuralValue) { Var(name=context) Var(name=expr) Var(name=params) Lit(value="") Lit(value=-1) } } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="Var") }
              Block { Return { Call(target=lower.appendStructuralValue) { Var(name=context) Var(name=expr) Var(name=params) Lit(value="") Lit(value=-1) } } }
              Block {
                If {
                  Eq { Var(name=indexOpcode) Lit(value="") }
                  Block {
                    If {
                      Eq { Var(name=unaryOpcode) Lit(value="") }
                      Block {
                        If {
                          Eq { Var(name=variadicOpcode) Lit(value="") }
                          Block {
                            If {
                              Eq { Var(name=binaryOpcode) Lit(value="") }
                              Block {
                                If {
                                  Eq { Var(name=kind) Lit(value="Eq") }
                                  Block { Return { Call(target=lower.appendStructuralNativeBinaryExpression) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Call(target=lower.structuralEqualityOp) { ChildAt { Var(name=expr) Lit(value=0) } ChildAt { Var(name=expr) Lit(value=1) } } } } }
                                  Block {
                                    If {
                                      Eq { Var(name=kind) Lit(value="Lt") }
                                      Block { Return { Call(target=lower.appendStructuralNativeBinaryExpression) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Lit(value="LT_NUM") } } }
                                      Block {
                                        If {
                                          Eq { Var(name=kind) Lit(value="Call") }
                                          Block {
                                            Let(name=targetName) { Call(target=lower.getAttr) { Var(name=expr) Lit(value="target") Lit(value=0) } }
                                            If {
                                              Call(target=lower.isStructuralSyscallTarget) { Var(name=targetName) }
                                              Block {
                                                Let(name=withTarget) { Call(target=blockBuilder.emit) { Var(name=context) Lit(value="CONST") StrConcat { Lit(value="string:") Var(name=targetName) } } }
                                                Let(name=withArguments) { Call(target=lower.appendStructuralNativeCallArguments) { Var(name=withTarget) Var(name=expr) Var(name=params) Var(name=records) Lit(value=0) } }
                                                Return { Call(target=blockBuilder.emit) { Var(name=withArguments) Lit(value="CALL_SYS") ToString { ChildCount { Var(name=expr) } } } }
                                              }
                                              Block {
                                                Let(name=target) { Call(target=lower.resolveStructuralCallSymbol) { Var(name=records) Var(name=targetName) Lit(value=0) } }
                                                If {
                                                  Eq { NodeKind { Var(name=target) } Lit(value="Err") }
                                                  Block { Return { Var(name=target) } }
                                                  Block { Return { Call(target=blockBuilder.emit) { Call(target=lower.appendStructuralNativeCallArguments) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Lit(value=0) } Lit(value="CALL") AttrValueString { Var(name=target) Lit(value=0) } } } }
                                                }
                                              }
                                            }
                                          }
                                          Block {
                                            If {
                                              Call(target=lower.isStructuralNumericBinaryExpression) { Var(name=expr) }
                                              Block { Return { Call(target=lower.appendStructuralNativeBinaryExpression) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Call(target=lower.structuralBinaryOp) { Var(name=expr) } } } }
                                              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER031") Lit(value="Structural native expression is unsupported.") NodeId { Var(name=expr) } } } }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              Block { Return { Call(target=lower.appendStructuralNativeBinaryExpression) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Var(name=binaryOpcode) } } }
                            }
                          }
                          Block { Return { Call(target=blockBuilder.emit) { Call(target=lower.appendStructuralNativeCallArguments) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Lit(value=0) } Var(name=variadicOpcode) Lit(value="") } } }
                        }
                      }
                      Block {
                        Let(name=withValue) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) ChildAt { Var(name=expr) Lit(value=0) } Var(name=params) Var(name=records) } }
                        Return { Call(target=blockBuilder.emit) { Var(name=withValue) Var(name=unaryOpcode) Lit(value="") } }
                      }
                    }
                  }
                  Block { Return { Call(target=lower.appendStructuralNativeNodeIndexExpression) { Var(name=context) Var(name=expr) Var(name=params) Var(name=records) Var(name=indexOpcode) } } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.appendStructuralNativeNodeIndexExpression) {
    Fn(params=context,expr,params,records,op) {
      Block {
        Let(name=withNode) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) ChildAt { Var(name=expr) Lit(value=0) } Var(name=params) Var(name=records) } }
        Let(name=withIndex) { Call(target=lower.appendStructuralNativeExpression) { Var(name=withNode) ChildAt { Var(name=expr) Lit(value=1) } Var(name=params) Var(name=records) } }
        Return { Call(target=blockBuilder.emit) { Var(name=withIndex) Var(name=op) Lit(value="") } }
      }
    }
  }

  Let(name=lower.isStructuralSyscallTarget) {
    Fn(params=target) {
      Block {
        Return { Eq { StringSlice { Var(name=target) Lit(value=0) Lit(value=4) } Lit(value="sys.") } }
      }
    }
  }

  Let(name=lower.appendStructuralNativeCallArguments) {
    Fn(params=context,call,params,records,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=call) } }
          Block { Return { Var(name=context) } }
          Block {
            Let(name=withArgument) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) ChildAt { Var(name=call) Var(name=index) } Var(name=params) Var(name=records) } }
            Return { Call(target=lower.appendStructuralNativeCallArguments) { Var(name=withArgument) Var(name=call) Var(name=params) Var(name=records) Add { Var(name=index) Lit(value=1) } } }
          }
        }
      }
    }
  }

  Let(name=lower.appendStructuralNativeBinaryExpression) {
    Fn(params=context,expr,params,records,op) {
      Block {
        Let(name=withLeft) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) ChildAt { Var(name=expr) Lit(value=0) } Var(name=params) Var(name=records) } }
        Let(name=withRight) { Call(target=lower.appendStructuralNativeExpression) { Var(name=withLeft) ChildAt { Var(name=expr) Lit(value=1) } Var(name=params) Var(name=records) } }
        Return { Call(target=blockBuilder.emit) { Var(name=withRight) Var(name=op) Lit(value="") } }
      }
    }
  }

  Let(name=lower.appendStructuralNativeBinding) {
    Fn(params=bindings,name) {
      Block {
        If {
          Eq { Var(name=bindings) Lit(value="") }
          Block { Return { Var(name=name) } }
          Block { Return { StrConcat { Var(name=bindings) StrConcat { Lit(value=",") Var(name=name) } } } }
        }
      }
    }
  }

  Let(name=lower.appendStructuralNativeTerminalSequence) {
    Fn(params=function,context,branch,bindings,records,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=branch) } }
          Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER032") Lit(value="Terminal branch is missing a Return or If.") NodeId { Var(name=branch) } } } }
          Block {
            Let(name=node) { ChildAt { Var(name=branch) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=node) } Lit(value="Let") }
              Block {
                Let(name=name) { Call(target=lower.getAttr) { Var(name=node) Lit(value="name") Lit(value=0) } }
                Let(name=value) { ChildAt { Var(name=node) Lit(value=0) } }
                Let(name=withValue) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) Var(name=value) Var(name=bindings) Var(name=records) } }
                If {
                  Call(target=lower.isStructuralError) { Var(name=withValue) }
                  Block { Return { Var(name=withValue) } }
                  Block {
                    Let(name=slot) { Call(target=lower.parameterCount) { Var(name=bindings) Lit(value=0) } }
                    Let(name=withStore) { Call(target=blockBuilder.emit) { Var(name=withValue) Lit(value="STORE_LOCAL") ToString { Var(name=slot) } } }
                    Return { Call(target=lower.appendStructuralNativeTerminalSequence) { Var(name=function) Var(name=withStore) Var(name=branch) Call(target=lower.appendStructuralNativeBinding) { Var(name=bindings) Var(name=name) } Var(name=records) Add { Var(name=index) Lit(value=1) } } }
                  }
                }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=node) } Lit(value="Call") }
                  Block {
                    Let(name=withCall) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) Var(name=node) Var(name=bindings) Var(name=records) } }
                    If {
                      Call(target=lower.isStructuralError) { Var(name=withCall) }
                      Block { Return { Var(name=withCall) } }
                      Block {
                        Let(name=withDiscard) { Call(target=blockBuilder.emit) { Var(name=withCall) Lit(value="POP") Lit(value="") } }
