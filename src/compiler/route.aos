Program {
  Import(path="parser.aos")

  Let(name=compiler.route) {
    Fn(params=path,table) {
      Block {
        Return {
          Call(target=route_find) {
            Var(name=path)
            Var(name=table)
            Lit(value=0)
          }
        }
      }
    }
  }

  Let(name=route_find) {
    Fn(params=path,table,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=table) } }
          Block { Return { Call(target=route_make_null) { Lit(value=0) } } }
          Block {
            Let(name=child) { ChildAt { Var(name=table) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=child) } Lit(value="Route") }
              Block {
                Let(name=routePath) {
                  Call(target=route_get_attr) {
                    Var(name=child)
                    Lit(value="path")
                    Lit(value=0)
                  }
                }
                If {
                  Eq { Var(name=routePath) Var(name=path) }
                  Block {
                    Let(name=handler) {
                      Call(target=route_get_attr) {
                        Var(name=child)
                        Lit(value="handler")
                        Lit(value=0)
                      }
                    }
                    Return { Call(target=route_make_match) { Var(name=handler) } }
                  }
                  Block {
                    Return {
                      Call(target=route_find) {
                        Var(name=path)
                        Var(name=table)
                        Add { Var(name=index) Lit(value=1) }
                      }
                    }
                  }
                }
              }
              Block {
                Return {
                  Call(target=route_find) {
                    Var(name=path)
                    Var(name=table)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=route_get_attr) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block {
                Return {
                  Call(target=route_get_attr) {
                    Var(name=node)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=route_make_match) {
    Fn(params=handler) {
      Block {
        Let(name=programText) {
          StrConcat {
            Lit(value="Program#rp1 { Match#auto(handler=\"")
            StrConcat {
              StrEscape { Var(name=handler) }
              Lit(value="\") }")
            }
          }
        }
        Let(name=parsed) { Call(target=parse.parseDocument) { Var(name=programText) } }
        Return { ChildAt { Var(name=parsed) Lit(value=0) } }
      }
    }
  }

  Let(name=route_make_null) {
    Fn(params=_) {
      Block {
        Let(name=parsed) { Call(target=parse.parseDocument) { Lit(value="Program#rp2 { Match#auto(handler=null) }") } }
        Return { ChildAt { Var(name=parsed) Lit(value=0) } }
      }
    }
  }
}
