Program {
  Let(name=platform) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.platform) }
      }
    }
  }

  Let(name=arch) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.arch) }
      }
    }
  }

  Let(name=osVersion) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.os.version) }
      }
    }
  }

  Let(name=runtime) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.runtime) }
      }
    }
  }

  Let(name=runtimeTarget) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.runtime.target) }
      }
    }
  }

  Let(name=runtimePlatform) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.runtime.platform) }
      }
    }
  }

  Let(name=openDefault) {
    Fn(params=target) {
      Block {
        Return { Call(target=sys.host.openDefault) { Var(name=target) } }
      }
    }
  }

  Let(name=openUrl) {
    Fn(params=url) {
      Block {
        Return { Call(target=openDefault) { Var(name=url) } }
      }
    }
  }

  Export(name=platform)
  Export(name=arch)
  Export(name=osVersion)
  Export(name=runtime)
  Export(name=runtimeTarget)
  Export(name=runtimePlatform)
  Export(name=openDefault)
  Export(name=openUrl)
}
