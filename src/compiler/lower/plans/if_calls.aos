        If {
          Call(target=lower.hasStructuralCallTarget) { Var(name=records) Var(name=thenName) Lit(value=0) }
          Block {
            If {
              Call(target=lower.hasStructuralCallTarget) { Var(name=records) Var(name=elseName) Lit(value=0) }
              Block {
                Let(name=thenTarget) { Call(target=lower.resolveStructuralCallSymbol) { Var(name=records) Var(name=thenName) Lit(value=0) } }
                Let(name=elseTarget) { Call(target=lower.resolveStructuralCallSymbol) { Var(name=records) Var(name=elseName) Lit(value=0) } }
                Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="") } }
                Let(name=entry0) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
                Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=entry0) Sub { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } Lit(value=1) } } }
                Let(name=entryCondition) { Call(target=lower.appendStructuralIfCallCondition) { Var(name=withParams) Var(name=condition) Var(name=params) } }
                Let(name=entryBranch) { Call(target=blockBuilder.terminateBranch) { Var(name=entryCondition) Lit(value="then") Lit(value="else") } }
                Let(name=then0) { Call(target=blockBuilder.beginBlock) { Lit(value="then") } }
                Let(name=then1) { Call(target=lower.appendStructuralCallArguments) { Var(name=then0) Var(name=thenCall) Var(name=params) Lit(value="") Lit(value=-1) Lit(value=0) } }
                Let(name=then2) { Call(target=blockBuilder.emit) { Var(name=then1) Lit(value="CALL") AttrValueString { Var(name=thenTarget) Lit(value=0) } } }
                Let(name=then3) { Call(target=blockBuilder.terminateReturn) { Var(name=then2) } }
                Let(name=else0) { Call(target=blockBuilder.beginBlock) { Lit(value="else") } }
                Let(name=else1) { Call(target=lower.appendStructuralCallArguments) { Var(name=else0) Var(name=elseCall) Var(name=params) Lit(value="") Lit(value=-1) Lit(value=0) } }
                Let(name=else2) { Call(target=blockBuilder.emit) { Var(name=else1) Lit(value="CALL") AttrValueString { Var(name=elseTarget) Lit(value=0) } } }
                Let(name=else3) { Call(target=blockBuilder.terminateReturn) { Var(name=else2) } }
                Let(name=withEntry) { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=entryBranch) } } }
                Let(name=withThen) { Call(target=blockBuilder.appendBlock) { Var(name=withEntry) Call(target=blockBuilder.seal) { Var(name=then3) } } }
                Return { Call(target=blockLinker.flatten) { Call(target=blockBuilder.appendBlock) { Var(name=withThen) Call(target=blockBuilder.seal) { Var(name=else3) } } } }
              }
              Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER026") Lit(value="Structural call target is unknown.") Var(name=elseName) } } }
            }
          }
          Block { Return { MakeErr { Lit(value="lower") Lit(value="LOWER026") Lit(value="Structural call target is unknown.") Var(name=thenName) } } }
        }
      }
    }
  }

  Let(name=lower.emitStructuralLocalIfRecordPlanWithSymbols) {
