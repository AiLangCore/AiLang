                Let(name=function) { Call(target=blockBuilder.beginFunction) { Var(name=name) Var(name=symbol) Var(name=params) Lit(value="local") } }
                Let(name=entry0) { Call(target=blockBuilder.beginBlock) { Lit(value="entry") } }
                Let(name=withParams) { Call(target=lower.appendStructuralParameterStores) { Var(name=entry0) Sub { Var(name=localSlot) Lit(value=1) } } }
                Let(name=withInit) { Call(target=lower.appendStructuralValue) { Var(name=withParams) Var(name=init) Var(name=params) Lit(value="") Lit(value=-1) } }
