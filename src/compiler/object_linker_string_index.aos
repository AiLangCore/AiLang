Program {
  Import(path="../std/collections/map.aos")
  Export(name=objectLinker.stringIndexEmpty)
  Export(name=objectLinker.stringIndexFinish)
  Export(name=objectLinker.stringIndexGet)
  Export(name=objectLinker.stringIndexPut)

  Let(name=objectLinker.stringIndexEmpty) {
    Fn() {
      Block {
        Return { Call(target=collections.mapBuilder) {} }
      }
    }
  }

  Let(name=objectLinker.stringIndexPut) {
    Fn(params=index,key,value) {
      Block {
        Return {
          Call(target=collections.mapBuilderPutStringInt) {
            Var(name=index) Var(name=key) Var(name=value)
          }
        }
      }
    }
  }

  Let(name=objectLinker.stringIndexFinish) {
    Fn(params=index) {
      Block {
        Return { Call(target=collections.mapBuilderFinish) { Var(name=index) } }
      }
    }
  }

  Let(name=objectLinker.stringIndexGet) {
    Fn(params=index,key,fallback) {
      Block {
        Return {
          Call(target=collections.mapGetStringIntOr) {
            Var(name=index) Var(name=key) Var(name=fallback)
          }
        }
      }
    }
  }
}
