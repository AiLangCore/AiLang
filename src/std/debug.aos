Program {
  Let(name=debugMode) {
    Fn(params=_) {
      Block {
        Return {
          Call(target=sys.debug.mode) { }
        }
      }
    }
  }

  Let(name=log) {
    Fn(params=level,message) {
      Block {
        Return {
          Call(target=sys.console.writeErrLine) {
            StrConcat {
              StrConcat {
                Lit(value="[")
                Var(name=level)
              }
              StrConcat {
                Lit(value="] ")
                Var(name=message)
              }
            }
          }
        }
      }
    }
  }

  Let(name=info) {
    Fn(params=message) {
      Block {
        Return {
          Call(target=log) {
            Lit(value="info")
            Var(name=message)
          }
        }
      }
    }
  }

  Let(name=warn) {
    Fn(params=message) {
      Block {
        Return {
          Call(target=log) {
            Lit(value="warn")
            Var(name=message)
          }
        }
      }
    }
  }

  Let(name=error) {
    Fn(params=message) {
      Block {
        Return {
          Call(target=log) {
            Lit(value="error")
            Var(name=message)
          }
        }
      }
    }
  }

  Let(name=debugAssert) {
    Fn(params=cond,code,message) {
      Block {
        If {
          Var(name=cond)
          Block { Return { Var(name=cond) } }
          Block {
            Call(target=log) {
              Lit(value="assert")
              StrConcat {
                Var(name=code)
                StrConcat {
                  Lit(value=" ")
                  Var(name=message)
                }
              }
            }
            Return { Var(name=cond) }
          }
        }
      }
    }
  }

  Export(name=debugMode)
  Export(name=log)
  Export(name=info)
  Export(name=warn)
  Export(name=error)
  Export(name=debugAssert)
}
