Program {
  Import(sdk="ailang" path="std/str.aos")
  Import(path="../common.aos")

  Export(name=runInit)

  Let(name=runInit) {
    Fn(params=args) {
      Block {
        Let(name=path) { Call(target=readArg) { Var(name=args) Lit(value=1) } }
        Let(name=template) { Call(target=readOption) { Var(name=args) Lit(value=1) Lit(value="--template") Lit(value="cli") } }
        Let(name=agent) { Call(target=readOption) { Var(name=args) Lit(value=1) Lit(value="--agent") Lit(value="codex") } }
        Let(name=agents) { Call(target=readOption) { Var(name=args) Lit(value=1) Lit(value="--agents") Var(name=agent) } }
        Let(name=force) { Call(target=hasFlag) { Var(name=args) Lit(value=1) Lit(value="--force") } }
        If {
          Eq { Var(name=path) Lit(value="") }
          Block { Return { Call(target=missingPath) { Lit(value="init") } } }
          Block {
            If {
              Call(target=isValidAgentList) { Var(name=agents) }
              Block {
                If {
                  Call(target=isKnownTemplate) { Var(name=template) }
                  Block {
                    If {
                      Call(target=isTemplateInstalled) { Var(name=template) }
                      Block {
                        If {
                          Call(target=sys.fs.path.exists) { Var(name=path) }
                          Block {
                            If {
                              Var(name=force)
                              Block { Return { Call(target=emitInitProject) { Var(name=path) Var(name=template) Var(name=agents) } } }
                              Block {
                                Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AILANG003 message=\"Directory already exists.\" nodeId=\"init\")") }
                                Return { Lit(value=1) }
                              }
                            }
                          }
                          Block { Return { Call(target=emitInitProject) { Var(name=path) Var(name=template) Var(name=agents) } } }
                        }
                      }
                      Block {
                        Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AILANG005 message=\"Template is not installed.\" nodeId=\"template\")") }
                        Return { Lit(value=1) }
                      }
                    }
                  }
                  Block {
                    Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AILANG004 message=\"Unknown template.\" nodeId=\"template\")") }
                    Return { Lit(value=1) }
                  }
                }
              }
              Block {
                Call(target=sys.stdout.writeLine) { Lit(value="Err#err0(code=AILANG006 message=\"Unknown agent.\" nodeId=\"agent\")") }
                Return { Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=isKnownTemplate) {
    Fn(params=template) {
      Block {
        If {
          Call(target=sys.fs.path.exists) { Lit(value="templates/projects/index.toml") }
          Block {
            Let(name=registry) { Call(target=readTextFile) { Lit(value="templates/projects/index.toml") } }
            Let(name=needle) { StrConcat { Lit(value="name = \"") StrConcat { Var(name=template) Lit(value="\"") } } }
            Let(name=found) { Call(target=find) { Var(name=registry) Var(name=needle) Lit(value=0) } }
            If {
              Eq { Var(name=found) Lit(value=-1) }
              Block { Return { Lit(value=false) } }
              Block { Return { Lit(value=true) } }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=isTemplateInstalled) {
    Fn(params=template) {
      Block {
        Let(name=templateDir) { StrConcat { Lit(value="templates/projects/") Var(name=template) } }
        If {
          Call(target=sys.fs.path.exists) { StrConcat { Var(name=templateDir) Lit(value="/template.toml") } }
          Block {
            If {
              Call(target=sys.fs.path.exists) { StrConcat { Var(name=templateDir) Lit(value="/project.aiproj.tpl") } }
              Block {
                If {
                  Call(target=sys.fs.path.exists) { StrConcat { Var(name=templateDir) Lit(value="/src/app.aos.tpl") } }
                  Block {
                    If {
                      Call(target=sys.fs.path.exists) { StrConcat { Var(name=templateDir) Lit(value="/AGENTS.md.tpl") } }
                      Block {
                        Return {
                          Call(target=sys.fs.path.exists) { StrConcat { Var(name=templateDir) Lit(value="/.gitignore.tpl") } }
                        }
                      }
                      Block { Return { Lit(value=false) } }
                    }
                  }
                  Block { Return { Lit(value=false) } }
                }
              }
              Block { Return { Lit(value=false) } }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=emitInitProject) {
    Fn(params=path,template,agents) {
      Block {
        Let(name=srcDir) { StrConcat { Var(name=path) Lit(value="/src") } }
        Let(name=assetsDir) { StrConcat { Var(name=path) Lit(value="/Assets") } }
        Let(name=assetsImagesDir) { StrConcat { Var(name=path) Lit(value="/Assets/images") } }
        Let(name=assetsFontsDir) { StrConcat { Var(name=path) Lit(value="/Assets/fonts") } }
        Let(name=assetsLocaleDir) { StrConcat { Var(name=path) Lit(value="/Assets/locale") } }
        Let(name=assetsLocaleFile) { StrConcat { Var(name=path) Lit(value="/Assets/locale/en.toml") } }
        Let(name=templateDir) { StrConcat { Lit(value="templates/projects/") Var(name=template) } }
        Let(name=projectTemplateFile) { StrConcat { Var(name=templateDir) Lit(value="/project.aiproj.tpl") } }
        Let(name=appTemplateFile) { StrConcat { Var(name=templateDir) Lit(value="/src/app.aos.tpl") } }
        Let(name=agentsTemplateFile) { StrConcat { Var(name=templateDir) Lit(value="/AGENTS.md.tpl") } }
        Let(name=gitignoreTemplateFile) { StrConcat { Var(name=templateDir) Lit(value="/.gitignore.tpl") } }
        Let(name=projectFile) { StrConcat { Var(name=path) Lit(value="/project.aiproj") } }
        Let(name=appFile) { StrConcat { Var(name=path) Lit(value="/src/app.aos") } }
        Let(name=agentsFile) { StrConcat { Var(name=path) Lit(value="/AGENTS.md") } }
        Let(name=gitignoreFile) { StrConcat { Var(name=path) Lit(value="/.gitignore") } }
        Call(target=sys.fs.dir.create) { Var(name=path) }
        Call(target=sys.fs.dir.create) { Var(name=srcDir) }
        Call(target=sys.fs.dir.create) { Var(name=assetsDir) }
        Call(target=sys.fs.dir.create) { Var(name=assetsImagesDir) }
        Call(target=sys.fs.dir.create) { Var(name=assetsFontsDir) }
        Call(target=sys.fs.dir.create) { Var(name=assetsLocaleDir) }
        Call(target=writeTextFile) { Var(name=projectFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=projectTemplateFile) } Var(name=path) } }
        Call(target=writeTextFile) { Var(name=appFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=appTemplateFile) } Var(name=path) } }
        Call(target=writeTextFile) { Var(name=agentsFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=agentsTemplateFile) } Var(name=path) } }
        Call(target=writeTextFile) { Var(name=gitignoreFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=gitignoreTemplateFile) } Var(name=path) } }
        Call(target=writeTextFile) { Var(name=assetsLocaleFile) Lit(value="# Locale seed data\n") }
        Call(target=writeAgentFiles) { Var(name=path) Var(name=agents) }
        Call(target=sys.stdout.writeLine) { Lit(value="Ok#ok1(type=string value=\"project-created\")") }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=renderProjectTemplate) {
    Fn(params=text,projectName) {
      Block {
        Let(name=step1) {
          Call(target=replaceAllKnown) {
            Var(name=text)
            Lit(value="{{project.name}}")
            Lit(value=16)
            Var(name=projectName)
          }
        }
        Let(name=step2) {
          Call(target=replaceAllKnown) {
            Var(name=step1)
            Lit(value="{{project.entryFile}}")
            Lit(value=21)
            Lit(value="src/app.aos")
          }
        }
        Let(name=step3) {
          Call(target=replaceAllKnown) {
            Var(name=step2)
            Lit(value="{{project.entryExport}}")
            Lit(value=23)
            Lit(value="start")
          }
        }
        Return {
          Call(target=replaceAllKnown) {
            Var(name=step3)
            Lit(value="{{project.version}}")
            Lit(value=19)
            Lit(value="0.0.1")
          }
        }
      }
    }
  }

  Let(name=replaceAllKnown) {
    Fn(params=text,needle,needleLength,replacement) {
      Block {
        If {
          Eq { Var(name=needleLength) Lit(value=0) }
          Block { Return { Var(name=text) } }
          Block {
            Let(name=at) {
              Call(target=find) {
                Var(name=text)
                Var(name=needle)
                Lit(value=0)
              }
            }
            If {
              Eq { Var(name=at) Lit(value=-1) }
              Block { Return { Var(name=text) } }
              Block {
                Let(name=prefix) {
                  Call(target=substring) {
                    Var(name=text)
                    Lit(value=0)
                    Var(name=at)
                  }
                }
                Let(name=suffixStart) { Add { Var(name=at) Var(name=needleLength) } }
                Let(name=suffix) {
                  Call(target=substring) {
                    Var(name=text)
                    Var(name=suffixStart)
                    Lit(value=2147483647)
                  }
                }
                Return {
                  StrConcat {
                    Var(name=prefix)
                    StrConcat {
                      Var(name=replacement)
                      Call(target=replaceAllKnown) {
                        Var(name=suffix)
                        Var(name=needle)
                        Var(name=needleLength)
                        Var(name=replacement)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=writeAgentFiles) {
    Fn(params=path,agents) {
      Block {
        Let(name=claudeFile) { StrConcat { Var(name=path) Lit(value="/CLAUDE.md") } }
        Let(name=geminiFile) { StrConcat { Var(name=path) Lit(value="/GEMINI.md") } }
        Let(name=windsurfFile) { StrConcat { Var(name=path) Lit(value="/.windsurfrules") } }
        Let(name=cursorDir) { StrConcat { Var(name=path) Lit(value="/.cursor") } }
        Let(name=cursorRulesDir) { StrConcat { Var(name=path) Lit(value="/.cursor/rules") } }
        Let(name=cursorFile) { StrConcat { Var(name=path) Lit(value="/.cursor/rules/ailang.mdc") } }
        Let(name=githubDir) { StrConcat { Var(name=path) Lit(value="/.github") } }
        Let(name=copilotFile) { StrConcat { Var(name=path) Lit(value="/.github/copilot-instructions.md") } }
        Let(name=claudeTemplateFile) { Lit(value="templates/agents/claude/CLAUDE.md.tpl") }
        Let(name=geminiTemplateFile) { Lit(value="templates/agents/gemini/GEMINI.md.tpl") }
        Let(name=windsurfTemplateFile) { Lit(value="templates/agents/windsurf/.windsurfrules.tpl") }
        Let(name=cursorTemplateFile) { Lit(value="templates/agents/cursor/.cursor/rules/ailang.mdc.tpl") }
        Let(name=copilotTemplateFile) { Lit(value="templates/agents/copilot/.github/copilot-instructions.md.tpl") }
        If {
          Call(target=hasAgent) { Var(name=agents) Lit(value="all") }
          Block {
            Call(target=writeTextFile) { Var(name=claudeFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=claudeTemplateFile) } Var(name=path) } }
            Call(target=writeTextFile) { Var(name=geminiFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=geminiTemplateFile) } Var(name=path) } }
            Call(target=writeTextFile) { Var(name=windsurfFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=windsurfTemplateFile) } Var(name=path) } }
            Call(target=sys.fs.dir.create) { Var(name=cursorDir) }
            Call(target=sys.fs.dir.create) { Var(name=cursorRulesDir) }
            Call(target=writeTextFile) { Var(name=cursorFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=cursorTemplateFile) } Var(name=path) } }
            Call(target=sys.fs.dir.create) { Var(name=githubDir) }
            Call(target=writeTextFile) { Var(name=copilotFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=copilotTemplateFile) } Var(name=path) } }
            Return { Lit(value=0) }
          }
          Block {
            If {
              Call(target=hasAgent) { Var(name=agents) Lit(value="claude") }
              Block { Call(target=writeTextFile) { Var(name=claudeFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=claudeTemplateFile) } Var(name=path) } } }
              Block { Lit(value=0) }
            }
            If {
              Call(target=hasAgent) { Var(name=agents) Lit(value="gemini") }
              Block { Call(target=writeTextFile) { Var(name=geminiFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=geminiTemplateFile) } Var(name=path) } } }
              Block { Lit(value=0) }
            }
            If {
              Call(target=hasAgent) { Var(name=agents) Lit(value="windsurf") }
              Block { Call(target=writeTextFile) { Var(name=windsurfFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=windsurfTemplateFile) } Var(name=path) } } }
              Block { Lit(value=0) }
            }
            If {
              Call(target=hasAgent) { Var(name=agents) Lit(value="cursor") }
              Block {
                Call(target=sys.fs.dir.create) { Var(name=cursorDir) }
                Call(target=sys.fs.dir.create) { Var(name=cursorRulesDir) }
                Call(target=writeTextFile) { Var(name=cursorFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=cursorTemplateFile) } Var(name=path) } }
              }
              Block { Lit(value=0) }
            }
            If {
              Call(target=hasAgent) { Var(name=agents) Lit(value="copilot") }
              Block {
                Call(target=sys.fs.dir.create) { Var(name=githubDir) }
                Call(target=writeTextFile) { Var(name=copilotFile) Call(target=renderProjectTemplate) { Call(target=readTextFile) { Var(name=copilotTemplateFile) } Var(name=path) } }
              }
              Block { Lit(value=0) }
            }
            Return { Lit(value=0) }
          }
        }
      }
    }
  }

  Let(name=isKnownAgent) {
    Fn(params=name) {
      Block {
        If {
          Eq { Var(name=name) Lit(value="codex") }
          Block { Return { Lit(value=true) } }
          Block {
            If {
              Eq { Var(name=name) Lit(value="claude") }
              Block { Return { Lit(value=true) } }
              Block {
                If {
                  Eq { Var(name=name) Lit(value="cursor") }
                  Block { Return { Lit(value=true) } }
                  Block {
                    If {
                      Eq { Var(name=name) Lit(value="gemini") }
                      Block { Return { Lit(value=true) } }
                      Block {
                        If {
                          Eq { Var(name=name) Lit(value="copilot") }
                          Block { Return { Lit(value=true) } }
                          Block { Return { Eq { Var(name=name) Lit(value="windsurf") } } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=isValidAgentList) {
    Fn(params=agents) {
      Block {
        If {
          Eq { Var(name=agents) Lit(value="all") }
          Block { Return { Lit(value=true) } }
          Block {
            Let(name=comma) { Call(target=find) { Var(name=agents) Lit(value=",") Lit(value=0) } }
            If {
              Eq { Var(name=comma) Lit(value=-1) }
              Block { Return { Call(target=isKnownAgent) { Var(name=agents) } } }
              Block {
                Let(name=first) { Call(target=substring) { Var(name=agents) Lit(value=0) Var(name=comma) } }
                Let(name=restStart) { Add { Var(name=comma) Lit(value=1) } }
                Let(name=rest) { Call(target=substring) { Var(name=agents) Var(name=restStart) Lit(value=2147483647) } }
                If {
                  Call(target=isKnownAgent) { Var(name=first) }
                  Block { Return { Call(target=isValidAgentList) { Var(name=rest) } } }
                  Block { Return { Lit(value=false) } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=hasAgent) {
    Fn(params=agents,name) {
      Block {
        If {
          Eq { Var(name=agents) Lit(value="all") }
          Block { Return { Lit(value=true) } }
          Block {
            If {
              Eq { Var(name=agents) Var(name=name) }
              Block { Return { Lit(value=true) } }
              Block {
                Let(name=normalizedAgents) { StrConcat { Lit(value=",") StrConcat { Var(name=agents) Lit(value=",") } } }
                Let(name=needle) { StrConcat { Lit(value=",") StrConcat { Var(name=name) Lit(value=",") } } }
                Let(name=found) { Call(target=find) { Var(name=normalizedAgents) Var(name=needle) Lit(value=0) } }
                If {
                  Eq { Var(name=found) Lit(value=-1) }
                  Block { Return { Lit(value=false) } }
                  Block { Return { Lit(value=true) } }
                }
              }
            }
          }
        }
      }
    }
  }
}
