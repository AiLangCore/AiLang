Program {
  Let(name=validate) {
    Fn(params=node) {
      Block {
        Return {
          Call(target=stateErrors) {
            Call(target=validateNode) {
              Var(name=node)
              Call(target=makeState) {
                MakeBlock { Lit(value="errs") }
                Lit(value="\n")
              }
            }
          }
        }
      }
    }
  }

  Let(name=makeErrors) {
    Fn(params=seed) {
      Block { Return { MakeBlock { Var(name=seed) } } }
    }
  }

  Let(name=makeIds) {
    Fn(params=seed) {
      Block { Return { Var(name=seed) } }
    }
  }

  Let(name=makeState) {
    Fn(params=errors,ids) {
      Block {
        Return {
          MakePair {
            Var(name=errors)
            Var(name=ids)
          }
        }
      }
    }
  }

  Let(name=stateErrors) {
    Fn(params=state) {
      Block { Return { PairFirst { Var(name=state) } } }
    }
  }

  Let(name=stateIds) {
    Fn(params=state) {
      Block { Return { PairSecond { Var(name=state) } } }
    }
  }

  Let(name=validateNode) {
    Fn(params=node,state) {
      Block {
        Let(name=errors) { Call(target=stateErrors) { Var(name=state) } }
        Let(name=ids) { Call(target=stateIds) { Var(name=state) } }
        Let(name=nodeId) { NodeId { Var(name=node) } }

        Let(name=errorsAfterId) {
          If {
            Call(target=idExists) { Var(name=ids) Var(name=nodeId) Lit(value=0) }
            Block { Call(target=addErr) { Var(name=errors) Lit(value="VAL001") Call(target=dupMessage) { Var(name=nodeId) } Var(name=nodeId) } }
            Block { Var(name=errors) }
          }
        }

        Let(name=idsAfter) { Call(target=addId) { Var(name=ids) Var(name=nodeId) } }
        Let(name=stateAfterSelf) { Call(target=makeState) { Var(name=errorsAfterId) Var(name=idsAfter) } }
        Let(name=stateAfterKind) { Call(target=validateKind) { Var(name=node) Var(name=stateAfterSelf) } }
        Return { Call(target=validateChildren) { Var(name=node) Var(name=stateAfterKind) Lit(value=0) } }
      }
    }
  }

  Let(name=validateChildren) {
    Fn(params=node,state,index) {
      Block {
        Return {
          If {
            Eq { Var(name=index) ChildCount { Var(name=node) } }
            Block { Var(name=state) }
            Block {
              Call(target=validateChildren) {
                Var(name=node)
                Call(target=validateNode) {
                  ChildAt { Var(name=node) Var(name=index) }
                  Var(name=state)
                }
                Add { Var(name=index) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=validateKind) {
    Fn(params=node,state) {
      Block {
        Let(name=kind) { NodeKind { Var(name=node) } }
        Let(name=errors) { Call(target=stateErrors) { Var(name=state) } }
        Let(name=ids) { Call(target=stateIds) { Var(name=state) } }
        Let(name=stateAfter) {
          If {
            Eq { Var(name=kind) Lit(value="Program") }
            Block { Var(name=state) }
            Block {
              If {
                Eq { Var(name=kind) Lit(value="Let") }
                Block { Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="name") Lit(value=1) } }
                Block {
                  If {
                    Eq { Var(name=kind) Lit(value="Var") }
                    Block { Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="name") Lit(value=0) } }
                    Block {
                      If {
                        Eq { Var(name=kind) Lit(value="Lit") }
                        Block { Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="value") Lit(value=0) } }
                        Block {
                          If {
                            Eq { Var(name=kind) Lit(value="Call") }
                            Block { Call(target=requireAttr) { Var(name=node) Var(name=state) Lit(value="target") } }
                            Block {
                              If {
                                Eq { Var(name=kind) Lit(value="If") }
                                Block { Call(target=requireIfShape) { Var(name=node) Var(name=state) } }
                                Block {
                                  If {
                                    Eq { Var(name=kind) Lit(value="Block") }
                                    Block { Var(name=state) }
                                    Block {
                                      If {
                                        Eq { Var(name=kind) Lit(value="Return") }
                                        Block { Call(target=requireReturnShape) { Var(name=node) Var(name=state) } }
                                        Block {
                                          If {
                                            Eq { Var(name=kind) Lit(value="Fn") }
                                            Block { Call(target=requireFnShape) { Var(name=node) Var(name=state) } }
                                            Block {
                                              If {
                                                Eq { Var(name=kind) Lit(value="Eq") }
                                                Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                Block {
                                                  If {
                                                    Eq { Var(name=kind) Lit(value="Add") }
                                                    Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                    Block {
                                                      If {
                                                        Eq { Var(name=kind) Lit(value="ToString") }
                                                        Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                        Block {
                                                          If {
                                                            Eq { Var(name=kind) Lit(value="NodeKind") }
                                                            Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                            Block {
                                                              If {
                                                                Eq { Var(name=kind) Lit(value="NodeId") }
                                                                Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                                Block {
                                                                  If {
                                                                    Eq { Var(name=kind) Lit(value="AttrCount") }
                                                                    Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                                    Block {
                                                                      If {
                                                                        Eq { Var(name=kind) Lit(value="AttrKey") }
                                                                        Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                        Block {
                                                                          If {
                                                                            Eq { Var(name=kind) Lit(value="AttrValueKind") }
                                                                            Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                            Block {
                                                                              If {
                                                                                Eq { Var(name=kind) Lit(value="AttrValueString") }
                                                                                Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                                Block {
                                                                                  If {
                                                                                    Eq { Var(name=kind) Lit(value="AttrValueInt") }
                                                                                    Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                                    Block {
                                                                                      If {
                                                                                        Eq { Var(name=kind) Lit(value="AttrValueBool") }
                                                                                        Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                                        Block {
                                                                                          If {
                                                                                            Eq { Var(name=kind) Lit(value="ChildCount") }
                                                                                            Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                                                            Block {
                                                                                              If {
                                                                                                Eq { Var(name=kind) Lit(value="ChildAt") }
                                                                                                Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                                                Block {
                                                                                                  If {
                                                                                                    Eq { Var(name=kind) Lit(value="StrConcat") }
                                                                                                    Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=2) } }
                                                                                                    Block {
                                                                                                      If {
                                                                                                        Eq { Var(name=kind) Lit(value="StrEscape") }
                                                                                                        Block { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
                                                                                                        Block {
                                                                                                          If {
                                                                                                            Eq { Var(name=kind) Lit(value="Import") }
                                                                                                            Block {
                                                                                                              Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="path") Lit(value=0) }
                                                                                                            }
                                                                                                            Block {
                                                                                                              If {
                                                                                                                Eq { Var(name=kind) Lit(value="Export") }
                                                                                                                Block {
                                                                                                                  Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="name") Lit(value=0) }
                                                                                                                }
                                                                                                                Block { Var(name=state) }
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                      }
                                                                                                    }
                                                                                                  }
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Let(name=stateAfterProject) {
          If {
            Eq { Var(name=kind) Lit(value="Project") }
            Block { Call(target=requireProjectShape) { Var(name=node) Var(name=stateAfter) } }
            Block { Var(name=stateAfter) }
          }
        }
        Let(name=stateAfterInclude) {
          If {
            Eq { Var(name=kind) Lit(value="Include") }
            Block { Call(target=requireIncludeShape) { Var(name=node) Var(name=stateAfterProject) } }
            Block { Var(name=stateAfterProject) }
          }
        }
        Let(name=stateAfterLoopControls) {
          If {
            Eq { Var(name=kind) Lit(value="Loop") }
            Block { Call(target=requireChildCount) { Var(name=node) Var(name=stateAfterInclude) Lit(value=1) } }
            Block {
              If {
                Eq { Var(name=kind) Lit(value="Break") }
                Block { Call(target=requireChildCount) { Var(name=node) Var(name=stateAfterInclude) Lit(value=0) } }
                Block {
                  If {
                    Eq { Var(name=kind) Lit(value="Continue") }
                    Block { Call(target=requireChildCount) { Var(name=node) Var(name=stateAfterInclude) Lit(value=0) } }
                    Block { Var(name=stateAfterInclude) }
                  }
                }
              }
            }
          }
        }
        Let(name=primitiveArity) { Call(target=textBytesPrimitiveArity) { Var(name=kind) } }
        Let(name=stateAfterTextBytesPrimitives) {
          If {
            Eq { Var(name=primitiveArity) Lit(value=-1) }
            Block { Var(name=stateAfterLoopControls) }
            Block { Call(target=requireChildCount) { Var(name=node) Var(name=stateAfterLoopControls) Var(name=primitiveArity) } }
          }
        }
        Let(name=stateAfterUnknownKind) {
          If {
            Eq { Var(name=primitiveArity) Lit(value=-1) }
            Block {
              If {
                Call(target=isKnownBaseKind) { Var(name=kind) }
                Block { Var(name=stateAfterTextBytesPrimitives) }
                Block {
                  Call(target=addErrForNode) {
                    Var(name=stateAfterTextBytesPrimitives)
                    Lit(value="VAL004")
                    Call(target=unknownKindMessage) { Var(name=kind) }
                    Var(name=node)
                  }
                }
              }
            }
            Block { Var(name=stateAfterTextBytesPrimitives) }
          }
        }
        Return { Var(name=stateAfterUnknownKind) }
      }
    }
  }

  Let(name=knownBaseKindText) {
    Fn(params=_) {
      Block {
        Return {
          Lit(value="|Program|Let|Var|Lit|Call|If|Block|Return|Fn|Eq|Add|ToString|NodeKind|NodeId|AttrCount|AttrKey|AttrValueKind|AttrValueString|AttrValueInt|AttrValueBool|ChildCount|ChildAt|StrConcat|StrEscape|Import|Export|Project|Include|Loop|Break|Continue|")
        }
      }
    }
  }

  Let(name=isKnownBaseKind) {
    Fn(params=kind) {
      Block {
        If {
          Eq {
            StringFind {
              Call(target=knownBaseKindText) { Lit(value=0) }
              StrConcat {
                StrConcat { Lit(value="|") Var(name=kind) }
                Lit(value="|")
              }
              Lit(value=0)
            }
            Lit(value=-1)
          }
          Block { Return { Lit(value=false) } }
          Block { Return { Lit(value=true) } }
        }
      }
    }
  }

  Let(name=unknownKindMessage) {
    Fn(params=kind) {
      Block {
        Return {
          StrConcat {
            StrConcat { Lit(value="Unsupported node kind '") Var(name=kind) }
            Lit(value="'.")
          }
        }
      }
    }
  }

  Let(name=textBytesPrimitiveArity) {
    Fn(params=kind) {
      Block {
        If {
          Eq { Var(name=kind) Lit(value="StringSlice") }
          Block { Return { Lit(value=3) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringRemove") }
          Block { Return { Lit(value=3) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringUtf8ByteCount") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringFind") }
          Block { Return { Lit(value=3) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringDecodeUnicodeHex4") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringDecodeUnicodeSurrogatePairHex4") }
          Block { Return { Lit(value=2) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringScalarLength") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringScalarAt") }
          Block { Return { Lit(value=2) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="StringFromCodePoint") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesLength") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesAt") }
          Block { Return { Lit(value=2) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesSlice") }
          Block { Return { Lit(value=3) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesConcat") }
          Block { Return { Lit(value=2) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesFromUtf8String") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesToUtf8String") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesFromBase64") }
          Block { Return { Lit(value=1) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=kind) Lit(value="BytesToBase64") }
          Block { Return { Lit(value=1) } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="BytesFromByte") }
              Block { Return { Lit(value=1) } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="BytesU32LE") }
                  Block { Return { Lit(value=1) } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="BytesI64LE") }
                      Block { Return { Lit(value=1) } }
                      Block {
            If {
              Eq { Var(name=kind) Lit(value="MakePair") }
              Block { Return { Lit(value=2) } }
              Block {
                If {
                  Eq { Var(name=kind) Lit(value="PairFirst") }
                  Block { Return { Lit(value=1) } }
                  Block {
                    If {
                      Eq { Var(name=kind) Lit(value="PairSecond") }
                      Block { Return { Lit(value=1) } }
                      Block {
                        If {
                          Eq { Var(name=kind) Lit(value="Sub") }
                          Block { Return { Lit(value=2) } }
                          Block {
                            If {
                              Eq { Var(name=kind) Lit(value="Mul") }
                              Block { Return { Lit(value=2) } }
                              Block {
                                If {
                                  Eq { Var(name=kind) Lit(value="Div") }
                                  Block { Return { Lit(value=2) } }
                                  Block {
                                    If {
                                      Eq { Var(name=kind) Lit(value="Mod") }
                                      Block { Return { Lit(value=2) } }
                                      Block {
                                        If {
                                          Eq { Var(name=kind) Lit(value="Pow") }
                                          Block { Return { Lit(value=2) } }
                                          Block {
                                            If {
                                              Eq { Var(name=kind) Lit(value="Lt") }
                                              Block { Return { Lit(value=2) } }
                                              Block { Return { Lit(value=-1) } }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=dupMessage) {
    Fn(params=id) {
      Block {
        Return {
          StrConcat {
            StrConcat { Lit(value="Duplicate node id '") Var(name=id) }
            Lit(value="'.")
          }
        }
      }
    }
  }

  Let(name=requireAttr) {
    Fn(params=node,state,key) {
      Block {
        If {
          Call(target=hasAttr) { Var(name=node) Var(name=key) Lit(value=0) }
          Block { Return { Var(name=state) } }
          Block { Return { Call(target=addErrForNode) { Var(name=state) Lit(value="VAL002") StrConcat { StrConcat { Lit(value="Missing attribute '") Var(name=key) } Lit(value="'.") } Var(name=node) } } }
        }
      }
    }
  }

  Let(name=requireAttrAndChildren) {
    Fn(params=node,state,key,count) {
      Block {
        Return {
          Call(target=requireChildCount) {
            Var(name=node)
            Call(target=requireAttr) { Var(name=node) Var(name=state) Var(name=key) }
            Var(name=count)
          }
        }
      }
    }
  }

  Let(name=requireChildCount) {
    Fn(params=node,state,count) {
      Block {
        If {
          Eq { ChildCount { Var(name=node) } Var(name=count) }
          Block { Return { Var(name=state) } }
          Block { Return { Call(target=addErrForNode) { Var(name=state) Lit(value="VAL003") Call(target=countMessage) { Var(name=node) Var(name=count) } Var(name=node) } } }
        }
      }
    }
  }

  Let(name=countMessage) {
    Fn(params=node,count) {
      Block {
        Return {
          StrConcat {
            StrConcat {
              StrConcat {
                StrConcat {
                  StrConcat { NodeKind { Var(name=node) } Lit(value=" expects ") }
                  ToString { Var(name=count) }
                }
                Lit(value="-")
              }
              ToString { Var(name=count) }
            }
            Lit(value=" children.")
          }
        }
      }
    }
  }

  Let(name=requireIfShape) {
    Fn(params=node,state) {
      Block {
        Let(name=count) { ChildCount { Var(name=node) } }
        Let(name=stateAfterCount) {
          If {
            Eq { Var(name=count) Lit(value=2) }
            Block { Var(name=state) }
            Block {
              If {
                Eq { Var(name=count) Lit(value=3) }
                Block { Var(name=state) }
                Block { Call(target=addErrForNode) { Var(name=state) Lit(value="VAL003") Lit(value="If expects 2-3 children.") Var(name=node) } }
              }
            }
          }
        }
        Let(name=stateAfterThen) {
          If {
            Eq { Var(name=count) Lit(value=2) }
            Block { Call(target=requireChildKind) { Var(name=node) Var(name=stateAfterCount) Lit(value=1) Lit(value="Block") Lit(value="VAL021") Lit(value="If then-branch must be Block.") } }
            Block {
              If {
                Eq { Var(name=count) Lit(value=3) }
                Block { Call(target=requireChildKind) { Var(name=node) Var(name=stateAfterCount) Lit(value=1) Lit(value="Block") Lit(value="VAL021") Lit(value="If then-branch must be Block.") } }
                Block { Var(name=stateAfterCount) }
              }
            }
          }
        }
        Return {
          If {
            Eq { Var(name=count) Lit(value=3) }
            Block { Call(target=requireChildKind) { Var(name=node) Var(name=stateAfterThen) Lit(value=2) Lit(value="Block") Lit(value="VAL022") Lit(value="If else-branch must be Block.") } }
            Block { Var(name=stateAfterThen) }
          }
        }
      }
    }
  }

  Let(name=requireReturnShape) {
    Fn(params=node,state) {
      Block {
        Let(name=count) { ChildCount { Var(name=node) } }
        If {
          Eq { Var(name=count) Lit(value=0) }
          Block { Return { Var(name=state) } }
          Block {
            If {
              Eq { Var(name=count) Lit(value=1) }
              Block { Return { Var(name=state) } }
              Block { Return { Call(target=addErrForNode) { Var(name=state) Lit(value="VAL003") Lit(value="Return expects 0-1 children.") Var(name=node) } } }
            }
          }
        }
      }
    }
  }

  Let(name=requireFnShape) {
    Fn(params=node,state) {
      Block {
        Let(name=stateAfterCount) { Call(target=requireChildCount) { Var(name=node) Var(name=state) Lit(value=1) } }
        Let(name=stateAfterAttr) { Call(target=requireAttr) { Var(name=node) Var(name=stateAfterCount) Lit(value="params") } }
        Return { Call(target=requireChildKind) { Var(name=node) Var(name=stateAfterAttr) Lit(value=0) Lit(value="Block") Lit(value="VAL050") Lit(value="Fn body must be Block.") } }
      }
    }
  }

  Let(name=requireChildKind) {
    Fn(params=node,state,index,expected,code,message) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=node) } }
          Block { Return { Var(name=state) } }
          Block {
            If {
              Eq { NodeKind { ChildAt { Var(name=node) Var(name=index) } } Var(name=expected) }
              Block { Return { Var(name=state) } }
              Block { Return { Call(target=addErrForNode) { Var(name=state) Var(name=code) Var(name=message) Var(name=node) } } }
            }
          }
        }
      }
    }
  }

  Let(name=hasAttr) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value=false) } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { Lit(value=true) } }
              Block { Return { Call(target=hasAttr) { Var(name=node) Var(name=key) Add { Var(name=index) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }

  Let(name=idExists) {
    Fn(params=ids,id,index) {
      Block {
        If {
          Eq {
            StringFind {
              Var(name=ids)
              StrConcat {
                StrConcat {
                  Lit(value="\n")
                  Var(name=id)
                }
                Lit(value="\n")
              }
              Lit(value=0)
            }
            Lit(value=-1)
          }
          Block { Return { Lit(value=false) } }
          Block { Return { Lit(value=true) } }
        }
      }
    }
  }

  Let(name=litValue) {
    Fn(params=node) {
      Block { Return { AttrValueString { Var(name=node) Lit(value=0) } } }
    }
  }

  Let(name=addErrForNode) {
    Fn(params=state,code,message,node) {
      Block {
        Return {
          Call(target=makeState) {
            Call(target=addErr) { Call(target=stateErrors) { Var(name=state) } Var(name=code) Var(name=message) NodeId { Var(name=node) } }
            Call(target=stateIds) { Var(name=state) }
          }
        }
      }
    }
  }

  Let(name=addErr) {
    Fn(params=errors,code,message,nodeId) {
      Block {
        Let(name=index) { ChildCount { Var(name=errors) } }
        Let(name=errId) { StrConcat { Lit(value="err-") ToString { Var(name=index) } } }
        Return { AppendChild { Var(name=errors) MakeErr { Var(name=errId) Var(name=code) Var(name=message) Var(name=nodeId) } } }
      }
    }
  }

  Let(name=addId) {
    Fn(params=ids,id) {
      Block {
        Return {
          StrConcat {
            StrConcat {
              Var(name=ids)
              Var(name=id)
            }
            Lit(value="\n")
          }
        }
      }
    }
  }

  Let(name=requireProjectShape) {
    Fn(params=node,state) {
      Block {
        Let(name=s1) { Call(target=requireAttr) { Var(name=node) Var(name=state) Lit(value="name") } }
        Let(name=s2) { Call(target=requireAttr) { Var(name=node) Var(name=s1) Lit(value="entryFile") } }
        Let(name=s3) { Call(target=requireAttr) { Var(name=node) Var(name=s2) Lit(value="entryExport") } }
        Let(name=s4) {
          If {
            Eq { Call(target=getAttrOrEmpty) { Var(name=node) Lit(value="entryExport") Lit(value=0) } Lit(value="") }
            Block { Call(target=addErrForNode) { Var(name=s3) Lit(value="VAL095") Lit(value="Project entryExport must be non-empty.") Var(name=node) } }
            Block { Var(name=s3) }
          }
        }
        Return { Call(target=requireProjectChildren) { Var(name=node) Var(name=s4) Lit(value=0) } }
      }
    }
  }

  Let(name=requireProjectChildren) {
    Fn(params=node,state,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=node) } }
          Block { Return { Var(name=state) } }
          Block {
            Let(name=child) { ChildAt { Var(name=node) Var(name=index) } }
            Let(name=stateAfterChild) {
              If {
                Eq { NodeKind { Var(name=child) } Lit(value="Include") }
                Block { Var(name=state) }
                Block {
                  Call(target=addErrForNode) {
                    Var(name=state)
                    Lit(value="VAL096")
                    Lit(value="Project children must be Include nodes.")
                    Var(name=child)
                  }
                }
              }
            }
            Return {
              Call(target=requireProjectChildren) {
                Var(name=node)
                Var(name=stateAfterChild)
                Add { Var(name=index) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=requireIncludeShape) {
    Fn(params=node,state) {
      Block {
        Let(name=s1) { Call(target=requireAttrAndChildren) { Var(name=node) Var(name=state) Lit(value="name") Lit(value=0) } }
        Let(name=s2) { Call(target=requireAttr) { Var(name=node) Var(name=s1) Lit(value="version") } }
        Return { Call(target=requireIncludePath) { Var(name=node) Var(name=s2) } }
      }
    }
  }

  Let(name=requireIncludePath) {
    Fn(params=node,state) {
      Block {
        If {
          Call(target=hasAttr) { Var(name=node) Lit(value="path") Lit(value=0) }
          Block {
            Let(name=path) { Call(target=getAttrOrEmpty) { Var(name=node) Lit(value="path") Lit(value=0) } }
            If {
              Call(target=isRelativePathText) { Var(name=path) }
              Block { Return { Var(name=state) } }
              Block {
                Return {
                  Call(target=addErrForNode) {
                    Var(name=state)
                    Lit(value="VAL097")
                    Lit(value="Include.path must be a non-empty relative path.")
                    Var(name=node)
                  }
                }
              }
            }
          }
          Block { Return { Var(name=state) } }
        }
      }
    }
  }

  Let(name=isRelativePathText) {
    Fn(params=path) {
      Block {
        If {
          Eq { Var(name=path) Lit(value="") }
          Block { Return { Lit(value=false) } }
          Block {
            If {
              Eq {
                StringSlice { Var(name=path) Lit(value=0) Lit(value=1) }
                Lit(value="/")
              }
              Block { Return { Lit(value=false) } }
              Block {
                If {
                  Eq {
                    StringFind { Var(name=path) Lit(value=":") Lit(value=0) }
                    Lit(value=-1)
                  }
                  Block { Return { Lit(value=true) } }
                  Block { Return { Lit(value=false) } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=getAttrOrEmpty) {
    Fn(params=node,key,index) {
      Block {
        If {
          Eq { Var(name=index) AttrCount { Var(name=node) } }
          Block { Return { Lit(value="") } }
          Block {
            If {
              Eq { AttrKey { Var(name=node) Var(name=index) } Var(name=key) }
              Block { Return { AttrValueString { Var(name=node) Var(name=index) } } }
              Block { Return { Call(target=getAttrOrEmpty) { Var(name=node) Var(name=key) Add { Var(name=index) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }
}
