                            If {
                              Eq { ChildCount { Var(name=expr) } Lit(value=2) }
                              Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=0) } } Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=1) } } } } }
                              Block { Return { Lit(value="") } }
                            }
                          }
                          Block {
                            If {
                              Eq { NodeKind { Var(name=expr) } Lit(value="Div") }
                              Block {
                                If {
                                  Eq { ChildCount { Var(name=expr) } Lit(value=2) }
                                  Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=0) } } Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=1) } } } } }
                                  Block { Return { Lit(value="") } }
                                }
                              }
                              Block {
                                If {
                                  Eq { NodeKind { Var(name=expr) } Lit(value="Mod") }
                                  Block {
                                    If {
                                      Eq { ChildCount { Var(name=expr) } Lit(value=2) }
                                      Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=0) } } Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=1) } } } } }
                                      Block { Return { Lit(value="") } }
                                    }
                                  }
                                  Block {
                                    If {
                                      Eq { NodeKind { Var(name=expr) } Lit(value="Eq") }
                                      Block {
                                        If {
                                          Eq { ChildCount { Var(name=expr) } Lit(value=2) }
                                          Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=0) } } Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=1) } } } } }
                                          Block { Return { Lit(value="") } }
                                        }
                                      }
                                      Block {
                                        If {
                                          Eq { NodeKind { Var(name=expr) } Lit(value="Lt") }
                                          Block {
                                            If {
                                              Eq { ChildCount { Var(name=expr) } Lit(value=2) }
                                              Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=0) } } Call(target=lower.emitIntLiteralConstant) { ChildAt { Var(name=expr) Lit(value=1) } } } } }
                                              Block { Return { Lit(value="") } }
                                            }
                                          }
                                          Block { Return { Lit(value="") } }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitExpressionIntConstant) {
    Fn(params=expr) {
      Block {
        If {
          Eq { NodeKind { Var(name=expr) } Lit(value="Match") }
          Block { Return { Call(target=lower.emitMatchConstants) { Var(name=expr) Lit(value=1) } } }
          Block { Return { Call(target=lower.emitExpressionIntConstantCore) { Var(name=expr) } } }
        }
      }
    }
  }

  Let(name=lower.literalMatchBlock) {
    Fn(params=matchNode,subject,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=matchNode) } }
          Block { Return { MakeBlock { Lit(value="no-match") } } }
          Block {
            Let(name=arm) { ChildAt { Var(name=matchNode) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=arm) } Lit(value="Case") }
              Block {
                Let(name=label) { ChildAt { Var(name=arm) Lit(value=0) } }
                If {
                  Call(target=lower.literalValuesEqual) { Var(name=subject) Var(name=label) }
                  Block { Return { ChildAt { Var(name=arm) Lit(value=1) } } }
                  Block { Return { Call(target=lower.literalMatchBlock) { Var(name=matchNode) Var(name=subject) Add { Var(name=index) Lit(value=1) } } } }
                }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=arm) } Lit(value="Default") }
                  Block { Return { ChildAt { Var(name=arm) Lit(value=0) } } }
                  Block { Return { MakeBlock { Lit(value="invalid-match-arm") } } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.literalMatchSelectedExpression) {
    Fn(params=matchNode) {
      Block {
        Let(name=subject) { ChildAt { Var(name=matchNode) Lit(value=0) } }
        If {
          Eq { NodeKind { Var(name=subject) } Lit(value="Lit") }
          Block {
            Let(name=block) { Call(target=lower.literalMatchBlock) { Var(name=matchNode) Var(name=subject) Lit(value=1) } }
            If {
              Eq { ChildCount { Var(name=block) } Lit(value=1) }
              Block { Return { ChildAt { Var(name=block) Lit(value=0) } } }
              Block { Return { MakeBlock { Lit(value="unsupported-match") } } }
            }
          }
          Block { Return { MakeBlock { Lit(value="unsupported-match-subject") } } }
        }
      }
    }
  }

  Let(name=lower.emitMatchConstants) {
    Fn(params=matchNode,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=matchNode) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=arm) { ChildAt { Var(name=matchNode) Var(name=index) } }
            Let(name=tail) { Call(target=lower.emitMatchConstants) { Var(name=matchNode) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=arm) } Lit(value="Case") }
              Block {
                Let(name=label) { ChildAt { Var(name=arm) Lit(value=0) } }
                Let(name=body) { ChildAt { Var(name=arm) Lit(value=1) } }
                If {
                  Eq { ChildCount { Var(name=body) } Lit(value=1) }
                  Block { Return { StrConcat { Call(target=lower.emitLiteralConstant) { Var(name=label) } StrConcat { Call(target=lower.emitExpressionIntConstantCore) { ChildAt { Var(name=body) Lit(value=0) } } Var(name=tail) } } } }
                  Block { Return { Var(name=tail) } }
                }
              }
              Block {
                If {
                  Eq { NodeKind { Var(name=arm) } Lit(value="Default") }
                  Block {
                    Let(name=body) { ChildAt { Var(name=arm) Lit(value=0) } }
                    If {
                      Eq { ChildCount { Var(name=body) } Lit(value=1) }
                      Block { Return { StrConcat { Call(target=lower.emitExpressionIntConstantCore) { ChildAt { Var(name=body) Lit(value=0) } } Var(name=tail) } } }
                      Block { Return { Var(name=tail) } }
                    }
                  }
                  Block { Return { Var(name=tail) } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitIntLiteralConstant) {
    Fn(params=value) {
      Block {
        If {
          Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
          Block {
            If {
              Eq { AttrValueKind { Var(name=value) Lit(value=0) } Lit(value="int") }
              Block { Return { StrConcat { Lit(value="Const(kind=\"int\" value=") StrConcat { ToString { AttrValueInt { Var(name=value) Lit(value=0) } } Lit(value=") ") } } } }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.literalConstantTarget) {
    Fn(params=value) {
      Block {
        Let(name=kind) { AttrValueKind { Var(name=value) Lit(value=0) } }
        If {
          Eq { Var(name=kind) Lit(value="int") }
          Block { Return { StrConcat { Lit(value="int:") ToString { AttrValueInt { Var(name=value) Lit(value=0) } } } } }
          Block {
            If {
              Eq { Var(name=kind) Lit(value="bool") }
              Block {
                If {
                  AttrValueBool { Var(name=value) Lit(value=0) }
                  Block { Return { Lit(value="bool:true") } }
                  Block { Return { Lit(value="bool:false") } }
                }
              }
              Block { Return { StrConcat { Lit(value="string:") StrEscape { AttrValueString { Var(name=value) Lit(value=0) } } } } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLiteralConstant) {
    Fn(params=value) {
      Block {
        If {
          Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
          Block {
            Let(name=target) { Call(target=lower.literalConstantTarget) { Var(name=value) } }
            Return { StrConcat { Lit(value="Const(kind=\"literal\" value=\"") StrConcat { Var(name=target) Lit(value="\") ") } } }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.literalValuesEqual) {
    Fn(params=left,right) {
      Block {
        Let(name=leftKind) { AttrValueKind { Var(name=left) Lit(value=0) } }
        Let(name=rightKind) { AttrValueKind { Var(name=right) Lit(value=0) } }
        If {
          Eq { Var(name=leftKind) Var(name=rightKind) }
          Block {
            If {
              Eq { Var(name=leftKind) Lit(value="int") }
              Block { Return { Eq { AttrValueInt { Var(name=left) Lit(value=0) } AttrValueInt { Var(name=right) Lit(value=0) } } } }
              Block {
                If {
                  Eq { Var(name=leftKind) Lit(value="bool") }
                  Block { Return { Eq { AttrValueBool { Var(name=left) Lit(value=0) } AttrValueBool { Var(name=right) Lit(value=0) } } } }
                  Block { Return { Eq { AttrValueString { Var(name=left) Lit(value=0) } AttrValueString { Var(name=right) Lit(value=0) } } } }
                }
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=lower.emitLocalThenReturnConstants) {
    Fn(params=body) {
      Block {
        Let(name=lastIndex) { Sub { ChildCount { Var(name=body) } Lit(value=1) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Var(name=lastIndex) } }
        Return {
          StrConcat {
            Call(target=lower.emitLocalConstantsAt) { Var(name=body) Lit(value=0) Var(name=lastIndex) }
            Call(target=lower.emitReturnArgumentConstants) { Var(name=returnNode) }
          }
        }
      }
    }
  }

  Let(name=lower.emitReturnArgumentConstants) {
    Fn(params=returnNode) {
      Block {
        If {
          Eq { NodeKind { Var(name=returnNode) } Lit(value="Return") }
          Block {
            If {
              Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
              Block {
                Let(name=expr) { ChildAt { Var(name=returnNode) Lit(value=0) } }
                If {
                  Eq { NodeKind { Var(name=expr) } Lit(value="Call") }
                  Block { Return { Call(target=lower.emitCallArgumentConstantsAt) { Var(name=expr) Lit(value=0) } } }
                  Block { Return { Lit(value="") } }
                }
              }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.emitCallArgumentConstantsAt) {
    Fn(params=callNode,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=callNode) } }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=argument) { ChildAt { Var(name=callNode) Var(name=index) } }
            Let(name=tail) { Call(target=lower.emitCallArgumentConstantsAt) { Var(name=callNode) Add { Var(name=index) Lit(value=1) } } }
            If {
              Eq { NodeKind { Var(name=argument) } Lit(value="Lit") }
              Block { Return { StrConcat { Call(target=lower.emitIntLiteralConstant) { Var(name=argument) } Var(name=tail) } } }
              Block {
                If {
                  Eq { NodeKind { Var(name=argument) } Lit(value="Var") }
                  Block { Return { Var(name=tail) } }
                  Block { Return { Lit(value="") } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLocalConstantsAt) {
    Fn(params=body,index,lastIndex) {
      Block {
        If {
          Eq { Var(name=index) Var(name=lastIndex) }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=localNode) { ChildAt { Var(name=body) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=localNode) } Lit(value="Let") }
              Block {
                If {
                  Eq { ChildCount { Var(name=localNode) } Lit(value=1) }
                  Block {
                    Let(name=value) { ChildAt { Var(name=localNode) Lit(value=0) } }
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
                      Block {
                        Let(name=constant) { Call(target=lower.emitIntLiteralConstant) { Var(name=value) } }
                        If {
                          Eq { Var(name=constant) Lit(value="") }
                          Block { Return { Lit(value="") } }
                          Block { Return { StrConcat { Var(name=constant) Call(target=lower.emitLocalConstantsAt) { Var(name=body) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) } } } }
                        }
                      }
                      Block {
                        If {
                          Eq { NodeKind { Var(name=value) } Lit(value="Var") }
                          Block { Return { Call(target=lower.emitLocalConstantsAt) { Var(name=body) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) } } }
                          Block {
                            If {
                              Eq { NodeKind { Var(name=value) } Lit(value="Call") }
                              Block {
                                Return {
                                  StrConcat {
                                    Call(target=lower.emitCallArgumentConstantsAt) { Var(name=value) Lit(value=0) }
                                    Call(target=lower.emitLocalConstantsAt) { Var(name=body) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) }
                                  }
                                }
                              }
                              Block { Return { Lit(value="") } }
                            }
                          }
                        }
                      }
                    }
                  }
                  Block { Return { Lit(value="") } }
                }
              }
              Block { Return { Lit(value="") } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitStdoutThenReturnConstants) {
    Fn(params=body) {
      Block {
        Let(name=callNode) { ChildAt { Var(name=body) Lit(value=0) } }
        Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=1) } }
        If {
          Eq { NodeKind { Var(name=callNode) } Lit(value="Call") }
          Block {
            If {
              Eq { Call(target=lower.getAttr) { Var(name=callNode) Lit(value="target") Lit(value=0) } Lit(value="sys.stdout.writeLine") }
              Block {
                Let(name=message) { Call(target=lower.stdoutStringLiteral) { Var(name=callNode) } }
                If {
                  Eq { NodeKind { Var(name=message) } Lit(value="Err") }
                  Block { Return { Lit(value="") } }
                  Block {
                    Let(name=returnBody) { AppendChild { MakeBlock { Lit(value="return-body") } Var(name=returnNode) } }
                    Let(name=returnConstants) { Call(target=lower.emitReturnConstants) { Var(name=returnBody) } }
                    Return {
                      StrConcat {
                        Lit(value="Const(kind=\"string\" value=\"sys.stdout.writeLine\") Const(kind=\"string\" value=\"")
                        StrConcat { StrEscape { AttrValueString { Var(name=message) Lit(value=0) } } StrConcat { Lit(value="\") ") Var(name=returnConstants) } }
                      }
                    }
                  }
                }
              }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.emitSingleReturnIntConstant) {
    Fn(params=body) {
      Block {
        If {
          Eq { ChildCount { Var(name=body) } Lit(value=1) }
          Block {
            Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=returnNode) } Lit(value="Return") }
              Block {
                If {
                  Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
                  Block {
                    Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
                      Block {
                        If {
                          Eq { AttrValueKind { Var(name=value) Lit(value=0) } Lit(value="int") }
                          Block { Return { StrConcat { Lit(value="Const(kind=\"int\" value=") StrConcat { ToString { AttrValueInt { Var(name=value) Lit(value=0) } } Lit(value=") ") } } } }
                          Block { Return { Lit(value="") } }
                        }
                      }
                      Block { Return { Lit(value="") } }
                    }
                  }
                  Block { Return { Lit(value="") } }
                }
              }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Return { Lit(value="") } }
        }
      }
    }
  }

  Let(name=lower.emitObjectFunctionBody) {
    Fn(params=record) {
      Block {
        Let(name=body) { ChildAt { Var(name=record) Lit(value=4) } }
        Let(name=params) { AttrValueString { ChildAt { Var(name=record) Lit(value=3) } Lit(value=0) } }
        Let(name=prolog) { Call(target=lower.emitParameterProlog) { Var(name=params) Lit(value=0) Lit(value=0) } }
        Let(name=prologCount) { Call(target=lower.parameterCount) { Var(name=params) Lit(value=0) } }
        If {
          Eq { ChildCount { Var(name=body) } Lit(value=1) }
          Block {
            Let(name=returnNode) { ChildAt { Var(name=body) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=returnNode) } Lit(value="Return") }
              Block {
                If {
                  Eq { ChildCount { Var(name=returnNode) } Lit(value=1) }
                  Block { Return { StrConcat { Var(name=prolog) Call(target=lower.emitReturnExpressionWithParams) { ChildAt { Var(name=returnNode) Lit(value=0) } Var(name=params) Var(name=prologCount) } } } }
                  Block { Return { Lit(value="Unsupported(reason=\"return-missing-expression\") ") } }
                }
              }
              Block { Return { Lit(value="Unsupported(reason=\"function-body-not-return\") ") } }
            }
          }
          Block {
            If {
              Lt { Lit(value=1) ChildCount { Var(name=body) } }
              Block {
                Let(name=first) { ChildAt { Var(name=body) Lit(value=0) } }
                If {
                  Eq { NodeKind { Var(name=first) } Lit(value="Let") }
                  Block { Return { StrConcat { Var(name=prolog) Call(target=lower.emitLocalThenReturnBody) { Var(name=body) Var(name=params) Var(name=prologCount) } } } }
                  Block { Return { Call(target=lower.emitStdoutThenReturnBody) { Var(name=body) } } }
                }
              }
              Block { Return { Lit(value="Unsupported(reason=\"function-body-shape\") ") } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLocalThenReturnBody) {
    Fn(params=body,params,baseSlot) {
      Block {
        Let(name=lastIndex) { Sub { ChildCount { Var(name=body) } Lit(value=1) } }
        Return { Call(target=lower.emitLocalBindingsAt) { Var(name=body) Var(name=params) Var(name=baseSlot) Lit(value=0) Var(name=lastIndex) Var(name=baseSlot) } }
      }
    }
  }

  Let(name=lower.emitLocalBindingsAt) {
    Fn(params=body,params,baseSlot,index,lastIndex,instructionIndex) {
      Block {
        If {
          Eq { Var(name=index) Var(name=lastIndex) }
          Block { Return { Call(target=lower.emitLocalReturn) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=lastIndex) Var(name=instructionIndex) } } }
          Block {
            Let(name=localNode) { ChildAt { Var(name=body) Var(name=index) } }
            If {
              Eq { NodeKind { Var(name=localNode) } Lit(value="Let") }
              Block {
                If {
                  Eq { ChildCount { Var(name=localNode) } Lit(value=1) }
                  Block {
                    Let(name=value) { ChildAt { Var(name=localNode) Lit(value=0) } }
                    If {
                      Eq { NodeKind { Var(name=value) } Lit(value="Lit") }
                      Block {
                        Let(name=slot) { Add { Var(name=baseSlot) Var(name=index) } }
                        Let(name=target) { Call(target=lower.literalConstantTarget) { Var(name=value) } }
                        Return {
                          StrConcat {
                            StrConcat {
                              Lit(value="Inst(op=\"CONST\" a=0) Reloc(kind=\"const\" instruction=")
                              StrConcat { ToString { Var(name=instructionIndex) } StrConcat { Lit(value=" target=\"") StrConcat { Var(name=target) Lit(value="\") Inst(op=\"STORE_LOCAL\" a=") } } }
                            }
                            StrConcat {
                              ToString { Var(name=slot) }
                              StrConcat { Lit(value=") ") Call(target=lower.emitLocalBindingsAt) { Var(name=body) Var(name=params) Var(name=baseSlot) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) Add { Var(name=instructionIndex) Lit(value=2) } } }
                            }
                          }
                        }
                      }
                      Block {
                        If {
                          Eq { NodeKind { Var(name=value) } Lit(value="Var") }
                          Block { Return { Call(target=lower.emitLocalVarBinding) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Var(name=instructionIndex) Var(name=value) } } }
                          Block {
                            If {
                              Eq { NodeKind { Var(name=value) } Lit(value="Call") }
                              Block { Return { Call(target=lower.emitLocalCallBinding) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Var(name=instructionIndex) Var(name=value) } } }
                              Block { Return { Lit(value="Unsupported(reason=\"local-value\") ") } }
                            }
                          }
                        }
                      }
                    }
                  }
                  Block { Return { Lit(value="Unsupported(reason=\"local-missing-value\") ") } }
                }
              }
              Block { Return { Lit(value="Unsupported(reason=\"local-binding\") ") } }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLocalVarBinding) {
    Fn(params=body,params,baseSlot,index,lastIndex,instructionIndex,value) {
      Block {
        Let(name=name) { Call(target=lower.getAttr) { Var(name=value) Lit(value="name") Lit(value=0) } }
        Let(name=parameterSlot) { Call(target=lower.parameterSlot) { Var(name=params) Var(name=name) Lit(value=0) Lit(value=0) } }
        Let(name=localSlot) { Call(target=lower.localSlot) { Var(name=body) Var(name=name) Var(name=baseSlot) Lit(value=0) Var(name=index) } }
        Let(name=targetSlot) { Add { Var(name=baseSlot) Var(name=index) } }
        If {
          Eq { Var(name=parameterSlot) Lit(value=-1) }
          Block {
            If {
              Eq { Var(name=localSlot) Lit(value=-1) }
              Block { Return { Lit(value="Unsupported(reason=\"unknown-local\") ") } }
              Block { Return { Call(target=lower.emitLocalCopyBinding) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Var(name=instructionIndex) Var(name=localSlot) Var(name=targetSlot) } } }
            }
          }
          Block { Return { Call(target=lower.emitLocalCopyBinding) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Var(name=instructionIndex) Var(name=parameterSlot) Var(name=targetSlot) } } }
        }
      }
    }
  }

  Let(name=lower.emitLocalCopyBinding) {
    Fn(params=body,params,baseSlot,index,lastIndex,instructionIndex,sourceSlot,targetSlot) {
      Block {
        Return {
          StrConcat {
            Lit(value="Inst(op=\"LOAD_LOCAL\" a=")
            StrConcat {
              ToString { Var(name=sourceSlot) }
              StrConcat {
                Lit(value=") Inst(op=\"STORE_LOCAL\" a=")
                StrConcat {
                  ToString { Var(name=targetSlot) }
                  StrConcat { Lit(value=") ") Call(target=lower.emitLocalBindingsAt) { Var(name=body) Var(name=params) Var(name=baseSlot) Add { Var(name=index) Lit(value=1) } Var(name=lastIndex) Add { Var(name=instructionIndex) Lit(value=2) } } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLocalCallBinding) {
    Fn(params=body,params,baseSlot,index,lastIndex,instructionIndex,callNode) {
      Block {
        Let(name=targetSlot) { Add { Var(name=baseSlot) Var(name=index) } }
        Let(name=target) { Call(target=lower.getAttr) { Var(name=callNode) Lit(value="target") Lit(value=0) } }
        If {
          Eq { ChildCount { Var(name=callNode) } Lit(value=0) }
          Block { Return { Call(target=lower.emitLocalCallAfterArgs) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Lit(value="") Var(name=target) Var(name=instructionIndex) Var(name=targetSlot) Add { Var(name=instructionIndex) Lit(value=2) } } } }
          Block {
            If {
              Eq { ChildCount { Var(name=callNode) } Lit(value=1) }
              Block {
                Let(name=argText) { Call(target=lower.emitScopedArgument) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=lastIndex) ChildAt { Var(name=callNode) Lit(value=0) } Var(name=instructionIndex) } }
                If {
                  Eq { Var(name=argText) Lit(value="") }
                  Block { Return { Lit(value="Unsupported(reason=\"call-argument\") ") } }
                  Block { Return { Call(target=lower.emitLocalCallAfterArgs) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) Var(name=argText) Var(name=target) Add { Var(name=instructionIndex) Lit(value=1) } Var(name=targetSlot) Add { Var(name=instructionIndex) Lit(value=3) } } } }
                }
              }
              Block {
                If {
                  Eq { ChildCount { Var(name=callNode) } Lit(value=2) }
                  Block {
                    Let(name=firstText) { Call(target=lower.emitScopedArgument) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=lastIndex) ChildAt { Var(name=callNode) Lit(value=0) } Var(name=instructionIndex) } }
                    Let(name=secondText) { Call(target=lower.emitScopedArgument) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=lastIndex) ChildAt { Var(name=callNode) Lit(value=1) } Add { Var(name=instructionIndex) Lit(value=1) } } }
                    If {
                      Eq { Var(name=firstText) Lit(value="") }
                      Block { Return { Lit(value="Unsupported(reason=\"call-argument\") ") } }
                      Block {
                        If {
                          Eq { Var(name=secondText) Lit(value="") }
                          Block { Return { Lit(value="Unsupported(reason=\"call-argument\") ") } }
                          Block { Return { Call(target=lower.emitLocalCallAfterArgs) { Var(name=body) Var(name=params) Var(name=baseSlot) Var(name=index) Var(name=lastIndex) StrConcat { Var(name=firstText) Var(name=secondText) } Var(name=target) Add { Var(name=instructionIndex) Lit(value=2) } Var(name=targetSlot) Add { Var(name=instructionIndex) Lit(value=4) } } } }
                        }
                      }
                    }
                  }
                  Block { Return { Lit(value="Unsupported(reason=\"call-arguments\") ") } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=lower.emitLocalCallAfterArgs) {
    Fn(params=body,params,baseSlot,index,lastIndex,argsText,target,callInstruction,targetSlot,nextInstruction) {
      Block {
        Return {
          StrConcat {
            Var(name=argsText)
