Program {
  Import(sdk="ailang" path="std/process.aos")
  Import(path="clean.aos")
  Export(name=main)

  Let(name=main) {
    Fn(params=args) {
      Block {
        Let(name=exitCode) { Call(target=runClean) { Var(name=args) } }
        Call(target=exit) { Var(name=exitCode) }
        Return { Var(name=exitCode) }
      }
    }
  }
}
