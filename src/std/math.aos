Program {
  Import(path="./number.aos")

  Let(name=halfFloor) {
    Fn(params=value,acc) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Lit(value=2) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=halfFloor) {
                Call(target=sub) { Var(name=value) Lit(value=2) }
                Call(target=inc) { Var(name=acc) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=divFloor) {
    Fn(params=value,step,acc) {
      Block {
        If {
          Call(target=lt) { Var(name=value) Var(name=step) }
          Block { Return { Var(name=acc) } }
          Block {
            Return {
              Call(target=divFloor) {
                Call(target=sub) { Var(name=value) Var(name=step) }
                Var(name=step)
                Call(target=inc) { Var(name=acc) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=subAbs) {
    Fn(params=a,b) {
      Block {
        Return {
          Call(target=abs) {
            Call(target=sub) {
              Var(name=a)
              Var(name=b)
            }
          }
        }
      }
    }
  }

  Export(name=halfFloor)
  Export(name=divFloor)
  Export(name=subAbs)
}
