Program {
  Let(name=lower.statementIf.appendReturn) {
    Fn(params=function,context,returnNode,bindings,records) {
      Block {
        If {
          Eq { ChildCount { Var(name=returnNode) } Lit(value=0) }
          Block {
            Let(name=withVoid) { Call(target=lower.appendVoidReturnValue) { Var(name=context) } }
            Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withVoid) } }
            Return { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } }
          }
          Block {
            Let(name=value) { ChildAt { Var(name=returnNode) Lit(value=0) } }
            If {
              Eq { NodeKind { Var(name=value) } Lit(value="CallDynamic") }
              Block {
                Return {
                  Call(target=lower.dynamicCall.appendReturn) {
                    Var(name=function) Var(name=context) Var(name=bindings) Var(name=records) Var(name=value)
                  }
                }
              }
              Block {
                Let(name=withValue) { Call(target=lower.appendStructuralNativeExpression) { Var(name=context) Var(name=value) Var(name=bindings) Var(name=records) } }
                If {
                  Call(target=lower.isStructuralError) { Var(name=withValue) }
                  Block { Return { Var(name=withValue) } }
                  Block {
                    Let(name=terminated) { Call(target=blockBuilder.terminateReturn) { Var(name=withValue) } }
                    Return { Call(target=blockBuilder.appendBlock) { Var(name=function) Call(target=blockBuilder.seal) { Var(name=terminated) } } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
